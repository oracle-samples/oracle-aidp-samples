            "worker_type": "G.1X",
            "num_workers": 5,
            "script": "import sys\nfrom awsglue.transforms import *\nfrom awsglue.utils import getResolvedOptions\nfrom pyspark.context import SparkContext\nfrom awsglue.context import GlueContext\nfrom awsglue.job import Job\nfrom awsglue.dynamicframe import DynamicFrame\n\nargs = getResolvedOptions(sys.argv, ['JOB_NAME', 'run_date'])\nsc = SparkContext()\nglueContext = GlueContext(sc)\nspark = glueContext.spark_session\njob = Job(glueContext)\njob.init(args['JOB_NAME'], args)\n\nclaims = glueContext.create_dynamic_frame.from_catalog(\n    database=\"acme_raw\", table_name=\"claim_events\", transformation_ctx=\"claims\")\nmapped = ApplyMapping.apply(frame=claims, mappings=[\n    (\"claim_id\", \"string\", \"claim_id\", \"string\"),\n    (\"amount\", \"string\", \"claim_amount\", \"double\"),\n    (\"filed_ts\", \"string\", \"filed_at\", \"timestamp\")])\ndf = mapped.toDF()\ndf = df.filter(df.claim_amount > 0)\ncurated = DynamicFrame.fromDF(df, glueContext, \"curated\")\nglueContext.write_dynamic_frame.from_options(frame=curated,\n    connection_type=\"s3\",\n    connection_options={\"path\": \"s3://acme-curated-data/claims/\"},\n    format=\"parquet\")\n\njob.commit()\n"
