    "positional_args": "ordered list of parameter names matching the def signature. For methods, INCLUDE 'self' as positional_args[0].",
    "args": "{param_name: role} where role is one of: table, db, bucket, path, full_id, mode. Roles db/bucket/path/full_id are redirected."
  },
