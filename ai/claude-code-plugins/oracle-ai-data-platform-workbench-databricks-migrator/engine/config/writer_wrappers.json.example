    "db": "migration_sandbox_overwrite",
    "bucket": "migration_sandbox",
    "bucket_namespace": "exmplnspace1",
    "path_template": "oci://migration_sandbox@exmplnspace1/<orig-bucket>/<orig-path>"
  },
