# infa2aidp Configuration
#
# Copy this template to .env and fill in your Anthropic API key:
#
#   cp env.template .env
#
# Never commit .env (already in .gitignore).

# ─────────────────────────────────────────────────────────────
# Required: Anthropic Claude API key
# ─────────────────────────────────────────────────────────────
# Get one at https://console.anthropic.com/settings/keys
# Without it, complex transformations fall back to rule-based only.

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional — override the default Claude model.
# Default: Opus 5 (best quality for ETL migration accuracy; runs adaptive
# thinking by default and is called with output_config={"effort": "xhigh"})
# Alternatives:
#   claude-sonnet-4-6           Sonnet 4.6 — cost-efficient for high volume
#   claude-haiku-4-5-20251001   Haiku 4.5  — fastest/cheapest (not recommended)
#
# CLAUDE_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────
# Migration tuning
# ─────────────────────────────────────────────────────────────
# Notebooks scoring below TARGET_SCORE get regenerated, up to MAX_ATTEMPTS times.
# Default values are good for most users — adjust only if needed.

TARGET_SCORE=90
MAX_ATTEMPTS=5
BATCH_WORKERS=5

# Batch auto re-run for low-score mappings (true/false)
AUTO_RERUN=false
MAX_RERUNS=3

# When LLM generation fails after MAX_ATTEMPTS:
#   false (default) → ERROR OUT (no silent fallback). Forces you to
#                     review the failure (the last raw LLM response is kept
#                     on the generator as _last_raw_response for debugging).
#   true            → fall back to rule-based converters. May produce
#                     notebooks with TODO placeholders for unsupported
#                     transforms (e.g. unconnected lookups, custom Java).
#                     Use only if you intend to manually fix the output.
RULE_BASED_FALLBACK=false

# Max output tokens per LLM call. Opus 5 supports up to 32000. The engine
# calls the streaming API (messages.stream), so 32000 is safe as a default
# — a non-streaming call this large would exceed Anthropic's non-streaming
# ceiling. Default 32000 (the ceiling) — large mappings can produce
# notebooks > 25 KB of source code. Drop only if you have a small-mapping
# workload and want stricter cost control.
CLAUDE_MAX_TOKENS=32000

# HTTP timeout per LLM call in seconds. Opus on long inputs can take
# a few minutes. Bump if you hit timeout errors.
CLAUDE_TIMEOUT_SECONDS=600

# ─────────────────────────────────────────────────────────────
# Cost guide (Opus 5 — same pricing as Opus 4.7: $5/$25 per MTok, 1M context)
# ─────────────────────────────────────────────────────────────
# ~$0.40 per attempt × up to 5 attempts → $0.40–$2.00 per mapping
# i.e. $40–$200 per 100 mappings (worst case)

# ─────────────────────────────────────────────────────────────
# AIDP deploy (optional — only needed for `infa2aidp deploy`)
# ─────────────────────────────────────────────────────────────
# Authentication auto-detected via OCI SDK from ~/.oci/config
# (Resource Principal → Instance Principal → Session Token → API Key).
# No host/token pair: there is no AIDP_HOST or AIDP_ACCESS_TOKEN.

# AIDP_REGION=us-ashburn-1
# AIDP_INSTANCE_ID=ocid1.aidataplatform.oc1.iad.xxx    # the DataLake OCID
# AIDP_WORKSPACE_KEY=your-workspace-key
# AIDP_CLUSTER_KEY=your-cluster-key                    # cluster the created jobs run on
# OCI_PROFILE=DEFAULT
# AIDP_WORKSPACE_PATH=/Workspace/Migrated

# Target catalog family the generated write cells assume (delta | adw).
# TARGET_CATALOG_TYPE=delta

# ─────────────────────────────────────────────────────────────
# Informatica source credentials (optional — only for `infa2aidp discover`)
# ─────────────────────────────────────────────────────────────
# INFA_USER=admin
# INFA_PASSWORD=secret
# INFA_REPO=REPO
# INFA_DOMAIN=Domain_infa

# ── IDMC / IICS (cloud) ──
# There is no IDMC export command in this release; export the mapping JSON
# from the IDMC UI/REST API (references/idmc-trial-setup.md) and pass the
# files to `migrate`. No INFA_IDMC_* variables are read by the engine.
