<?xml version="1.0" encoding="UTF-8"?>
<!--
  Construct fixture: ONE export file containing THREE mappings.

  A PowerCenter folder export routinely carries many mappings. Every other
  fixture in this repo carries exactly one, so a code path that reads only
  the first cannot be distinguished from one that reads all of them.

  Deliberately minimal per mapping: the point is the count, not the logic.
-->
<POWERMART CREATION_DATE="01/15/2026 09:00:00" REPOSITORY_VERSION="189.96">
<REPOSITORY NAME="REP_DEV" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MULTI" GROUP="" OWNER="dev" SHARED="NOTSHARED">

  <SOURCE NAME="SRC_A" DBDNAME="ORA_SRC" OWNERNAME="APP" DATABASETYPE="Oracle">
    <SOURCEFIELD NAME="ID"  DATATYPE="number" PRECISION="10" SCALE="0" FIELDNUMBER="1"/>
    <SOURCEFIELD NAME="VAL" DATATYPE="varchar2" PRECISION="50" SCALE="0" FIELDNUMBER="2"/>
  </SOURCE>
  <TARGET NAME="TGT_A" DATABASETYPE="Oracle">
    <TARGETFIELD NAME="ID"  DATATYPE="number" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY"/>
    <TARGETFIELD NAME="VAL" DATATYPE="varchar2" PRECISION="50" SCALE="0" KEYTYPE="NOT A KEY"/>
  </TARGET>

  <MAPPING NAME="m_first" ISVALID="YES">
    <INSTANCE NAME="SQ_A"  TRANSFORMATION_NAME="SRC_A" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
    <INSTANCE NAME="TGT_A" TRANSFORMATION_NAME="TGT_A" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
    <CONNECTOR FROMINSTANCE="SQ_A" FROMFIELD="ID"  TOINSTANCE="TGT_A" TOFIELD="ID"/>
    <CONNECTOR FROMINSTANCE="SQ_A" FROMFIELD="VAL" TOINSTANCE="TGT_A" TOFIELD="VAL"/>
  </MAPPING>

  <MAPPING NAME="m_second" ISVALID="YES">
    <INSTANCE NAME="SQ_A"  TRANSFORMATION_NAME="SRC_A" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
    <INSTANCE NAME="TGT_A" TRANSFORMATION_NAME="TGT_A" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
    <CONNECTOR FROMINSTANCE="SQ_A" FROMFIELD="ID"  TOINSTANCE="TGT_A" TOFIELD="ID"/>
    <CONNECTOR FROMINSTANCE="SQ_A" FROMFIELD="VAL" TOINSTANCE="TGT_A" TOFIELD="VAL"/>
  </MAPPING>

  <MAPPING NAME="m_third" ISVALID="YES">
    <INSTANCE NAME="SQ_A"  TRANSFORMATION_NAME="SRC_A" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE"/>
    <INSTANCE NAME="TGT_A" TRANSFORMATION_NAME="TGT_A" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
    <CONNECTOR FROMINSTANCE="SQ_A" FROMFIELD="ID"  TOINSTANCE="TGT_A" TOFIELD="ID"/>
    <CONNECTOR FROMINSTANCE="SQ_A" FROMFIELD="VAL" TOINSTANCE="TGT_A" TOFIELD="VAL"/>
  </MAPPING>

</FOLDER>
</REPOSITORY>
</POWERMART>
