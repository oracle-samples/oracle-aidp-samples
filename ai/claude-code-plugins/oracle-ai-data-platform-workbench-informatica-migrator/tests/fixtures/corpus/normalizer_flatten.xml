<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_normalizer_flatten" DESCRIPTION="Flatten repeated groups using Normalizer transform">
    <SOURCE NAME="MONTHLY_SALES" DBDNAME="SALES_DB" OWNERNAME="SALES" DATABASETYPE="Oracle" DESCRIPTION="Monthly sales with a repeated-group array column">
        <SOURCEFIELD NAME="PRODUCT_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="SALES_ARRAY" DATATYPE="string" PRECISION="200" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_FLAT_SALES" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Flattened monthly sales fact">
        <TARGETFIELD NAME="PRODUCT_ID_OUT" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="MONTH_SALE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="RUNNING_TOTAL" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="MONTHLY_SALES" TYPE="SOURCE" TRANSFORMATION_NAME="MONTHLY_SALES" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_FLAT_SALES" TYPE="TARGET" TRANSFORMATION_NAME="TGT_FLAT_SALES" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_MONTHLY_SALES" TYPE="Source Qualifier">
        <TRANSFORMFIELD NAME="PRODUCT_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="SALES_ARRAY" DATATYPE="string" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="NRM_FLATTEN_SALES" TYPE="Normalizer">
        <TRANSFORMFIELD NAME="PRODUCT_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="SALES_ARRAY" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="PRODUCT_ID_OUT" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="MONTH_SALE" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="GK" DATATYPE="integer" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_CALC" TYPE="Expression">
        <TRANSFORMFIELD NAME="PRODUCT_ID_OUT" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="MONTH_SALE" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="RUNNING_TOTAL" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="MONTH_SALE * 1.05"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="MONTHLY_SALES" FROMFIELD="PRODUCT_ID" TOINSTANCE="SQ_MONTHLY_SALES" TOFIELD="PRODUCT_ID"/>
    <CONNECTOR FROMINSTANCE="MONTHLY_SALES" FROMFIELD="SALES_ARRAY" TOINSTANCE="SQ_MONTHLY_SALES" TOFIELD="SALES_ARRAY"/>
    <CONNECTOR FROMINSTANCE="SQ_MONTHLY_SALES" FROMFIELD="PRODUCT_ID" TOINSTANCE="NRM_FLATTEN_SALES" TOFIELD="PRODUCT_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_MONTHLY_SALES" FROMFIELD="SALES_ARRAY" TOINSTANCE="NRM_FLATTEN_SALES" TOFIELD="SALES_ARRAY"/>
    <CONNECTOR FROMINSTANCE="NRM_FLATTEN_SALES" FROMFIELD="PRODUCT_ID_OUT" TOINSTANCE="EXP_CALC" TOFIELD="PRODUCT_ID_OUT"/>
    <CONNECTOR FROMINSTANCE="NRM_FLATTEN_SALES" FROMFIELD="MONTH_SALE" TOINSTANCE="EXP_CALC" TOFIELD="MONTH_SALE"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC" FROMFIELD="PRODUCT_ID_OUT" TOINSTANCE="TGT_FLAT_SALES" TOFIELD="PRODUCT_ID_OUT"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC" FROMFIELD="MONTH_SALE" TOINSTANCE="TGT_FLAT_SALES" TOFIELD="MONTH_SALE"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC" FROMFIELD="RUNNING_TOTAL" TOINSTANCE="TGT_FLAT_SALES" TOFIELD="RUNNING_TOTAL"/>
</MAPPING>
