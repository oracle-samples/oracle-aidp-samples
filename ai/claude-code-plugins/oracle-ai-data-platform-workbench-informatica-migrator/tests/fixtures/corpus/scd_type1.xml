<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_scd_type1" DESCRIPTION="SCD Type 1: overwrite existing rows">
    <SOURCE NAME="CUSTOMERS_STAGE" DBDNAME="CRM_DB" OWNERNAME="STAGING" DATABASETYPE="Oracle" DESCRIPTION="Staged customer records">
        <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="NAME" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="EMAIL" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="PHONE" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_CUSTOMERS" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Customer dimension, SCD Type 1">
        <TARGETFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="NAME" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="CLEAN_EMAIL" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="CLEAN_PHONE" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="CUSTOMERS_STAGE" TYPE="SOURCE" TRANSFORMATION_NAME="CUSTOMERS_STAGE" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_CUSTOMERS" TYPE="TARGET" TRANSFORMATION_NAME="TGT_CUSTOMERS" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_CUSTOMERS" TYPE="Source Qualifier">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT CUSTOMER_ID, NAME, EMAIL, PHONE FROM CUSTOMERS_STAGE"/>
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="NAME" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="EMAIL" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="PHONE" DATATYPE="string" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_VALIDATE" TYPE="Expression">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="NAME" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="EMAIL" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="PHONE" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="CLEAN_EMAIL" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="LOWER(TRIM(EMAIL))"/>
        <TRANSFORMFIELD NAME="CLEAN_PHONE" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="REPLACE(REPLACE(PHONE, '-', ''), ' ', '')"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="CUSTOMERS_STAGE" FROMFIELD="CUSTOMER_ID" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS_STAGE" FROMFIELD="NAME" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="NAME"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS_STAGE" FROMFIELD="EMAIL" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="EMAIL"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS_STAGE" FROMFIELD="PHONE" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="PHONE"/>
    <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="CUSTOMER_ID" TOINSTANCE="EXP_VALIDATE" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="NAME" TOINSTANCE="EXP_VALIDATE" TOFIELD="NAME"/>
    <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="EMAIL" TOINSTANCE="EXP_VALIDATE" TOFIELD="EMAIL"/>
    <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="PHONE" TOINSTANCE="EXP_VALIDATE" TOFIELD="PHONE"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="CUSTOMER_ID" TOINSTANCE="TGT_CUSTOMERS" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="NAME" TOINSTANCE="TGT_CUSTOMERS" TOFIELD="NAME"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="CLEAN_EMAIL" TOINSTANCE="TGT_CUSTOMERS" TOFIELD="CLEAN_EMAIL"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="CLEAN_PHONE" TOINSTANCE="TGT_CUSTOMERS" TOFIELD="CLEAN_PHONE"/>
</MAPPING>
