<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_star_schema_fact" DESCRIPTION="Build fact table from staging with dimension lookups">
    <SOURCE NAME="SALES_STAGE" DBDNAME="SALES_DB" OWNERNAME="STAGING" DATABASETYPE="Oracle" DESCRIPTION="Staged point-of-sale transactions">
        <SOURCEFIELD NAME="SALE_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="PRODUCT_CODE" DATATYPE="string" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="CUSTOMER_CODE" DATATYPE="string" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="SALE_DATE" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="QUANTITY" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="UNIT_PRICE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_SALES_FACT" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Sales fact table">
        <TARGETFIELD NAME="SALE_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="PRODUCT_SK" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="CUSTOMER_SK" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="REVENUE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="DISCOUNT_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="SALES_STAGE" TYPE="SOURCE" TRANSFORMATION_NAME="SALES_STAGE" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_SALES_FACT" TYPE="TARGET" TRANSFORMATION_NAME="TGT_SALES_FACT" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_SALES_STAGE" TYPE="Source Qualifier">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT * FROM SALES_STAGE"/>
        <TRANSFORMFIELD NAME="SALE_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="PRODUCT_CODE" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_CODE" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="SALE_DATE" DATATYPE="date" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="QUANTITY" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="UNIT_PRICE" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="LKP_PRODUCT_DIM" TYPE="Lookup">
        <TABLEATTRIBUTE NAME="condition" VALUE="LKP_PRODUCT_DIM.PRODUCT_CODE = SQ_SALES_STAGE.PRODUCT_CODE"/>
        <TRANSFORMFIELD NAME="PRODUCT_CODE" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="PRODUCT_SK" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="CATEGORY" DATATYPE="string" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="LKP_CUSTOMER_DIM" TYPE="Lookup">
        <TABLEATTRIBUTE NAME="condition" VALUE="LKP_CUSTOMER_DIM.CUSTOMER_CODE = SQ_SALES_STAGE.CUSTOMER_CODE"/>
        <TRANSFORMFIELD NAME="CUSTOMER_CODE" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_SK" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="REGION" DATATYPE="string" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_CALC_METRICS" TYPE="Expression">
        <TRANSFORMFIELD NAME="SALE_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="QUANTITY" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="UNIT_PRICE" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="PRODUCT_SK" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_SK" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="REVENUE" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="QUANTITY * UNIT_PRICE"/>
        <TRANSFORMFIELD NAME="DISCOUNT_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="IIF(QUANTITY > 10, QUANTITY * UNIT_PRICE * 0.05, 0)"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="SALES_STAGE" FROMFIELD="SALE_ID" TOINSTANCE="SQ_SALES_STAGE" TOFIELD="SALE_ID"/>
    <CONNECTOR FROMINSTANCE="SALES_STAGE" FROMFIELD="PRODUCT_CODE" TOINSTANCE="SQ_SALES_STAGE" TOFIELD="PRODUCT_CODE"/>
    <CONNECTOR FROMINSTANCE="SALES_STAGE" FROMFIELD="CUSTOMER_CODE" TOINSTANCE="SQ_SALES_STAGE" TOFIELD="CUSTOMER_CODE"/>
    <CONNECTOR FROMINSTANCE="SALES_STAGE" FROMFIELD="SALE_DATE" TOINSTANCE="SQ_SALES_STAGE" TOFIELD="SALE_DATE"/>
    <CONNECTOR FROMINSTANCE="SALES_STAGE" FROMFIELD="QUANTITY" TOINSTANCE="SQ_SALES_STAGE" TOFIELD="QUANTITY"/>
    <CONNECTOR FROMINSTANCE="SALES_STAGE" FROMFIELD="UNIT_PRICE" TOINSTANCE="SQ_SALES_STAGE" TOFIELD="UNIT_PRICE"/>
    <CONNECTOR FROMINSTANCE="SQ_SALES_STAGE" FROMFIELD="PRODUCT_CODE" TOINSTANCE="LKP_PRODUCT_DIM" TOFIELD="PRODUCT_CODE"/>
    <CONNECTOR FROMINSTANCE="SQ_SALES_STAGE" FROMFIELD="CUSTOMER_CODE" TOINSTANCE="LKP_CUSTOMER_DIM" TOFIELD="CUSTOMER_CODE"/>
    <CONNECTOR FROMINSTANCE="LKP_PRODUCT_DIM" FROMFIELD="PRODUCT_SK" TOINSTANCE="EXP_CALC_METRICS" TOFIELD="PRODUCT_SK"/>
    <CONNECTOR FROMINSTANCE="LKP_CUSTOMER_DIM" FROMFIELD="CUSTOMER_SK" TOINSTANCE="EXP_CALC_METRICS" TOFIELD="CUSTOMER_SK"/>
    <CONNECTOR FROMINSTANCE="SQ_SALES_STAGE" FROMFIELD="QUANTITY" TOINSTANCE="EXP_CALC_METRICS" TOFIELD="QUANTITY"/>
    <CONNECTOR FROMINSTANCE="SQ_SALES_STAGE" FROMFIELD="UNIT_PRICE" TOINSTANCE="EXP_CALC_METRICS" TOFIELD="UNIT_PRICE"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC_METRICS" FROMFIELD="SALE_ID" TOINSTANCE="TGT_SALES_FACT" TOFIELD="SALE_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC_METRICS" FROMFIELD="REVENUE" TOINSTANCE="TGT_SALES_FACT" TOFIELD="REVENUE"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC_METRICS" FROMFIELD="PRODUCT_SK" TOINSTANCE="TGT_SALES_FACT" TOFIELD="PRODUCT_SK"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC_METRICS" FROMFIELD="CUSTOMER_SK" TOINSTANCE="TGT_SALES_FACT" TOFIELD="CUSTOMER_SK"/>
    <CONNECTOR FROMINSTANCE="EXP_CALC_METRICS" FROMFIELD="DISCOUNT_AMOUNT" TOINSTANCE="TGT_SALES_FACT" TOFIELD="DISCOUNT_AMOUNT"/>
</MAPPING>
