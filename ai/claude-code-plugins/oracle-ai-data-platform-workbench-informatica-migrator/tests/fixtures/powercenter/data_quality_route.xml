<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_data_quality_route" DESCRIPTION="Route records to valid, invalid, and error targets">
    <SOURCE NAME="TRANSACTIONS" DBDNAME="PAYMENTS_DB" OWNERNAME="PAYMENTS" DATABASETYPE="Oracle" DESCRIPTION="Raw incoming transactions">
        <SOURCEFIELD NAME="TXN_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="CURRENCY" DATATYPE="string" PRECISION="3" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="TXN_DATE" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_VALID_TRANSACTIONS" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Transactions that passed data-quality routing">
        <TARGETFIELD NAME="TXN_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="TRANSACTIONS" TYPE="SOURCE" TRANSFORMATION_NAME="TRANSACTIONS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_VALID_TRANSACTIONS" TYPE="TARGET" TRANSFORMATION_NAME="TGT_VALID_TRANSACTIONS" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_TRANSACTIONS" TYPE="Source Qualifier">
        <TRANSFORMFIELD NAME="TXN_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="CURRENCY" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="TXN_DATE" DATATYPE="date" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_VALIDATE" TYPE="Expression">
        <TRANSFORMFIELD NAME="TXN_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="CURRENCY" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="IS_VALID_CURRENCY" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(CURRENCY IN ('USD', 'EUR', 'GBP'), 1, 0)"/>
        <TRANSFORMFIELD NAME="IS_POSITIVE" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(AMOUNT > 0, 1, 0)"/>
        <TRANSFORMFIELD NAME="IS_NULL_AMOUNT" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(ISNULL(AMOUNT), 1, 0)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="RTR_QUALITY" TYPE="Router">
        <GROUP NAME="valid" CONDITION="IS_VALID_CURRENCY = 1 AND IS_POSITIVE = 1 AND IS_NULL_AMOUNT = 0"/>
        <GROUP NAME="invalid_currency" CONDITION="IS_VALID_CURRENCY = 0"/>
        <GROUP NAME="negative_amount" CONDITION="IS_POSITIVE = 0 AND IS_NULL_AMOUNT = 0"/>
        <GROUP NAME="null_amount"/>
        <TRANSFORMFIELD NAME="TXN_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="IS_VALID_CURRENCY" DATATYPE="integer" PORTTYPE="INPUT"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="TRANSACTIONS" FROMFIELD="TXN_ID" TOINSTANCE="SQ_TRANSACTIONS" TOFIELD="TXN_ID"/>
    <CONNECTOR FROMINSTANCE="TRANSACTIONS" FROMFIELD="AMOUNT" TOINSTANCE="SQ_TRANSACTIONS" TOFIELD="AMOUNT"/>
    <CONNECTOR FROMINSTANCE="TRANSACTIONS" FROMFIELD="CURRENCY" TOINSTANCE="SQ_TRANSACTIONS" TOFIELD="CURRENCY"/>
    <CONNECTOR FROMINSTANCE="TRANSACTIONS" FROMFIELD="TXN_DATE" TOINSTANCE="SQ_TRANSACTIONS" TOFIELD="TXN_DATE"/>
    <CONNECTOR FROMINSTANCE="SQ_TRANSACTIONS" FROMFIELD="TXN_ID" TOINSTANCE="EXP_VALIDATE" TOFIELD="TXN_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_TRANSACTIONS" FROMFIELD="AMOUNT" TOINSTANCE="EXP_VALIDATE" TOFIELD="AMOUNT"/>
    <CONNECTOR FROMINSTANCE="SQ_TRANSACTIONS" FROMFIELD="CURRENCY" TOINSTANCE="EXP_VALIDATE" TOFIELD="CURRENCY"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="TXN_ID" TOINSTANCE="RTR_QUALITY" TOFIELD="TXN_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="AMOUNT" TOINSTANCE="RTR_QUALITY" TOFIELD="AMOUNT"/>
    <CONNECTOR FROMINSTANCE="EXP_VALIDATE" FROMFIELD="IS_VALID_CURRENCY" TOINSTANCE="RTR_QUALITY" TOFIELD="IS_VALID_CURRENCY"/>
    <CONNECTOR FROMINSTANCE="RTR_QUALITY" FROMFIELD="TXN_ID" TOINSTANCE="TGT_VALID_TRANSACTIONS" TOFIELD="TXN_ID"/>
    <CONNECTOR FROMINSTANCE="RTR_QUALITY" FROMFIELD="AMOUNT" TOINSTANCE="TGT_VALID_TRANSACTIONS" TOFIELD="AMOUNT"/>
</MAPPING>
