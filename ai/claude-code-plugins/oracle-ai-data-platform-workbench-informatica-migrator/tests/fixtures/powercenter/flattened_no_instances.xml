<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  DELIBERATELY INCOMPLETE. Do not "fix" this fixture.

  A transformation-only mapping with no top-level SOURCE or TARGET
  definitions and no INSTANCE elements. It exists to pin the generator's
  behaviour when an export does not carry source/target wiring: the source
  read must fall back to a named placeholder and the target write must be
  skipped with a stated reason, rather than the generator inventing a table
  name that would produce a notebook that runs against the wrong data.

  This path used to be covered by accident. Eight fixtures in the demo
  corpus were flattened copies of complete mappings that exist in this same
  directory, so every one of them exercised the no-metadata path and none
  of them exercised the read/write path. Restoring the complete copies
  would have removed this coverage entirely, so it is now carried by one
  fixture that is stripped on purpose and says so.
-->
<POWERMART CREATION_DATE="09/23/2026" REPOSITORY_VERSION="188.96">
<REPOSITORY NAME="TEST_REP" VERSION="188" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="TEST_FOLDER" OWNER="Administrator" SHARED="NOTSHARED">

<MAPPING DESCRIPTION="Transformation-only: no SOURCE, no TARGET, no INSTANCE"
         ISVALID="YES" NAME="m_flattened_no_instances" OBJECTVERSION="1"
         VERSIONNUMBER="1">

    <TRANSFORMATION DESCRIPTION="" NAME="EXP_DERIVE" OBJECTVERSION="1"
                    REUSABLE="NO" TYPE="Expression" VERSIONNUMBER="1">
        <TRANSFORMFIELD DATATYPE="decimal" DEFAULTVALUE="" DESCRIPTION=""
                        NAME="AMOUNT" PICTURETEXT="" PORTTYPE="INPUT"
                        PRECISION="15" SCALE="2"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION=""
                        NAME="STATUS" PICTURETEXT="" PORTTYPE="INPUT"
                        PRECISION="20" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="decimal" DEFAULTVALUE=""
                        DESCRIPTION="" EXPRESSION="AMOUNT * 0.9"
                        EXPRESSIONTYPE="GENERAL" NAME="NET_AMOUNT"
                        PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="15"
                        SCALE="2"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE=""
                        DESCRIPTION="" EXPRESSION="UPPER(STATUS)"
                        EXPRESSIONTYPE="GENERAL" NAME="STATUS_UPPER"
                        PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="20"
                        SCALE="0"/>
    </TRANSFORMATION>

    <TRANSFORMATION DESCRIPTION="" NAME="FIL_ACTIVE" OBJECTVERSION="1"
                    REUSABLE="NO" TYPE="Filter" VERSIONNUMBER="1">
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION=""
                        NAME="STATUS_UPPER" PICTURETEXT=""
                        PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="decimal" DEFAULTVALUE="" DESCRIPTION=""
                        NAME="NET_AMOUNT" PICTURETEXT=""
                        PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="2"/>
        <TABLEATTRIBUTE NAME="Filter Condition" VALUE="STATUS_UPPER != 'CANCELLED'"/>
    </TRANSFORMATION>

    <CONNECTOR FROMFIELD="NET_AMOUNT" FROMINSTANCE="EXP_DERIVE"
               FROMINSTANCETYPE="Expression" TOFIELD="NET_AMOUNT"
               TOINSTANCE="FIL_ACTIVE" TOINSTANCETYPE="Filter"/>
    <CONNECTOR FROMFIELD="STATUS_UPPER" FROMINSTANCE="EXP_DERIVE"
               FROMINSTANCETYPE="Expression" TOFIELD="STATUS_UPPER"
               TOINSTANCE="FIL_ACTIVE" TOINSTANCETYPE="Filter"/>

</MAPPING>
</FOLDER>
</REPOSITORY>
</POWERMART>
