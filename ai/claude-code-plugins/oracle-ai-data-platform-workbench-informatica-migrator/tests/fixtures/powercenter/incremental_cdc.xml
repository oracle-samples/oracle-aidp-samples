<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_incremental_cdc" DESCRIPTION="Incremental load using CDC watermark on updated_at">
    <SOURCE NAME="ORDERS" DBDNAME="SALES_DB" OWNERNAME="SALES" DATABASETYPE="Oracle" DESCRIPTION="Order header source">
        <SOURCEFIELD NAME="ORDER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="STATUS" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="UPDATED_AT" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_ORDERS_DW" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Order fact, incrementally loaded">
        <TARGETFIELD NAME="ORDER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="AMOUNT_WITH_TAX" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="STATUS" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="IS_HIGH_VALUE" DATATYPE="integer" PRECISION="1" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="LOAD_TS" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="ORDERS" TYPE="SOURCE" TRANSFORMATION_NAME="ORDERS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_ORDERS_DW" TYPE="TARGET" TRANSFORMATION_NAME="TGT_ORDERS_DW" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_ORDERS_CDC" TYPE="Source Qualifier">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT * FROM ORDERS WHERE UPDATED_AT > :LAST_RUN_TS"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="STATUS" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="UPDATED_AT" DATATYPE="date" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="FIL_VALID_ORDERS" TYPE="Filter">
        <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(ORDER_ID) AND TOTAL_AMOUNT > 0"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="STATUS" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="UPDATED_AT" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_ENRICH" TYPE="Expression">
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="STATUS" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT_WITH_TAX" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="TOTAL_AMOUNT * 1.1"/>
        <TRANSFORMFIELD NAME="IS_HIGH_VALUE" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(TOTAL_AMOUNT > 1000, 1, 0)"/>
        <TRANSFORMFIELD NAME="LOAD_TS" DATATYPE="date" PORTTYPE="OUTPUT" EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="SQ_ORDERS_CDC" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="CUSTOMER_ID" TOINSTANCE="SQ_ORDERS_CDC" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="TOTAL_AMOUNT" TOINSTANCE="SQ_ORDERS_CDC" TOFIELD="TOTAL_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="STATUS" TOINSTANCE="SQ_ORDERS_CDC" TOFIELD="STATUS"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="UPDATED_AT" TOINSTANCE="SQ_ORDERS_CDC" TOFIELD="UPDATED_AT"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS_CDC" FROMFIELD="ORDER_ID" TOINSTANCE="FIL_VALID_ORDERS" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS_CDC" FROMFIELD="TOTAL_AMOUNT" TOINSTANCE="FIL_VALID_ORDERS" TOFIELD="TOTAL_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="EXP_ENRICH" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_ORDERS" FROMFIELD="TOTAL_AMOUNT" TOINSTANCE="EXP_ENRICH" TOFIELD="TOTAL_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_ORDERS" FROMFIELD="STATUS" TOINSTANCE="EXP_ENRICH" TOFIELD="STATUS"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="ORDER_ID" TOINSTANCE="TGT_ORDERS_DW" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="AMOUNT_WITH_TAX" TOINSTANCE="TGT_ORDERS_DW" TOFIELD="AMOUNT_WITH_TAX"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="STATUS" TOINSTANCE="TGT_ORDERS_DW" TOFIELD="STATUS"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="IS_HIGH_VALUE" TOINSTANCE="TGT_ORDERS_DW" TOFIELD="IS_HIGH_VALUE"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="LOAD_TS" TOINSTANCE="TGT_ORDERS_DW" TOFIELD="LOAD_TS"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_ORDERS" FROMFIELD="CUSTOMER_ID" TOINSTANCE="TGT_ORDERS_DW" TOFIELD="CUSTOMER_ID"/>
</MAPPING>
