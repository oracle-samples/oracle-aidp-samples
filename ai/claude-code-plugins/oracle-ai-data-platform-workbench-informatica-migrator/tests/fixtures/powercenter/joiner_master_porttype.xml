<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored for this project.

     The opposite of joiner_no_master_flag.xml: here the Joiner's master side
     IS declared, through PORTTYPE="INPUT/OUTPUT/MASTER" on the ports fed by
     the master source. The parser used not to read that spelling, which made
     the master side unresolvable on exports that state it perfectly clearly.

     The join type is MASTER OUTER, so the direction decides which rows
     survive and a resolved master side is required rather than optional. -->
<POWERMART CREATION_DATE="10/03/2026" REPOSITORY_VERSION="189.96">
<REPOSITORY NAME="REP_RETAIL" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="RETAIL_DM" OWNER="dev" SHARED="NOTSHARED" DESCRIPTION="Order fulfilment datamart">

<SOURCE NAME="shipment" DBDNAME="OPSDB" OWNERNAME="OPS" DATABASETYPE="Oracle" DESCRIPTION="Shipments (detail)">
  <SOURCEFIELD NAME="SHIPMENT_ID" DATATYPE="number"   PRECISION="12" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="ORDER_ID"    DATATYPE="number"   PRECISION="12" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="SHIP_DATE"   DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="CARRIER"     DATATYPE="varchar2" PRECISION="40" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<SOURCE NAME="order_header" DBDNAME="OPSDB" OWNERNAME="OPS" DATABASETYPE="Oracle" DESCRIPTION="Order headers (master)">
  <SOURCEFIELD NAME="ORDER_ID"    DATATYPE="number"   PRECISION="12" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="ORDER_STATUS" DATATYPE="varchar2" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<TARGET NAME="fct_fulfilment" DATABASETYPE="Oracle" DBDNAME="DMDB" OWNERNAME="DM" DESCRIPTION="Fulfilment fact">
  <TARGETFIELD NAME="SHIPMENT_ID"  DATATYPE="number"   PRECISION="12" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="ORDER_ID"     DATATYPE="number"   PRECISION="12" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="ORDER_STATUS" DATATYPE="varchar2" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="SHIP_DATE"    DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>

<MAPPING NAME="m_order_fulfilment" DESCRIPTION="Shipments outer-joined to order headers" ISVALID="YES">
  <INSTANCE NAME="shipment"       TYPE="SOURCE" TRANSFORMATION_NAME="shipment"       TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="order_header"   TYPE="SOURCE" TRANSFORMATION_NAME="order_header"   TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="fct_fulfilment" TYPE="TARGET" TRANSFORMATION_NAME="fct_fulfilment" TRANSFORMATION_TYPE="Target Definition"/>

  <TRANSFORMATION NAME="SQ_shipment" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="SHIPMENT_ID" DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="ORDER_ID"    DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="SHIP_DATE"   DATATYPE="date"     PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="CARRIER"     DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="SQ_order_header" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="ORDER_ID"     DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="ORDER_STATUS" DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="JNR_ship_order" TYPE="Joiner" DESCRIPTION="Shipments to order headers">
    <TRANSFORMFIELD NAME="SHIPMENT_ID"  DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="ORDER_ID"     DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="SHIP_DATE"    DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="ORDER_ID_M"   DATATYPE="number"   PORTTYPE="INPUT/OUTPUT/MASTER"/>
    <TRANSFORMFIELD NAME="ORDER_STATUS" DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT/MASTER"/>
    <TABLEATTRIBUTE NAME="Join Condition" VALUE="ORDER_ID_M = ORDER_ID"/>
    <TABLEATTRIBUTE NAME="Join Type" VALUE="MASTER OUTER"/>
  </TRANSFORMATION>

  <CONNECTOR FROMINSTANCE="shipment" FROMFIELD="SHIPMENT_ID" TOINSTANCE="SQ_shipment" TOFIELD="SHIPMENT_ID"/>
  <CONNECTOR FROMINSTANCE="shipment" FROMFIELD="ORDER_ID"    TOINSTANCE="SQ_shipment" TOFIELD="ORDER_ID"/>
  <CONNECTOR FROMINSTANCE="shipment" FROMFIELD="SHIP_DATE"   TOINSTANCE="SQ_shipment" TOFIELD="SHIP_DATE"/>
  <CONNECTOR FROMINSTANCE="shipment" FROMFIELD="CARRIER"     TOINSTANCE="SQ_shipment" TOFIELD="CARRIER"/>

  <CONNECTOR FROMINSTANCE="order_header" FROMFIELD="ORDER_ID"     TOINSTANCE="SQ_order_header" TOFIELD="ORDER_ID"/>
  <CONNECTOR FROMINSTANCE="order_header" FROMFIELD="ORDER_STATUS" TOINSTANCE="SQ_order_header" TOFIELD="ORDER_STATUS"/>

  <CONNECTOR FROMINSTANCE="SQ_shipment" FROMFIELD="SHIPMENT_ID" TOINSTANCE="JNR_ship_order" TOFIELD="SHIPMENT_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_shipment" FROMFIELD="ORDER_ID"    TOINSTANCE="JNR_ship_order" TOFIELD="ORDER_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_shipment" FROMFIELD="SHIP_DATE"   TOINSTANCE="JNR_ship_order" TOFIELD="SHIP_DATE"/>
  <CONNECTOR FROMINSTANCE="SQ_order_header" FROMFIELD="ORDER_ID"     TOINSTANCE="JNR_ship_order" TOFIELD="ORDER_ID_M"/>
  <CONNECTOR FROMINSTANCE="SQ_order_header" FROMFIELD="ORDER_STATUS" TOINSTANCE="JNR_ship_order" TOFIELD="ORDER_STATUS"/>

  <CONNECTOR FROMINSTANCE="JNR_ship_order" FROMFIELD="SHIPMENT_ID"  TOINSTANCE="fct_fulfilment" TOFIELD="SHIPMENT_ID"/>
  <CONNECTOR FROMINSTANCE="JNR_ship_order" FROMFIELD="ORDER_ID"     TOINSTANCE="fct_fulfilment" TOFIELD="ORDER_ID"/>
  <CONNECTOR FROMINSTANCE="JNR_ship_order" FROMFIELD="ORDER_STATUS" TOINSTANCE="fct_fulfilment" TOFIELD="ORDER_STATUS"/>
  <CONNECTOR FROMINSTANCE="JNR_ship_order" FROMFIELD="SHIP_DATE"    TOINSTANCE="fct_fulfilment" TOFIELD="SHIP_DATE"/>
</MAPPING>

<SESSION NAME="s_m_order_fulfilment" MAPPINGNAME="m_order_fulfilment" DESCRIPTION="Load fulfilment fact" ISVALID="YES" REUSABLE="NO">
  <CONNECTIONREFERENCE CONNECTIONNAME="OPSDB_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Source" INSTANCENAME="shipment" COMPONENTNAME="Source Qualifier Reader"/>
  <CONNECTIONREFERENCE CONNECTIONNAME="DMDB_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Target" INSTANCENAME="fct_fulfilment" COMPONENTNAME="Target Writer"/>
</SESSION>

</FOLDER>
</REPOSITORY>
</POWERMART>
