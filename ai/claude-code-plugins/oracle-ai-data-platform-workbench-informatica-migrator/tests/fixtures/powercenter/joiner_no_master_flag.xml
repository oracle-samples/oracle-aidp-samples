<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored for this project.

     Covers a Joiner whose ports carry NO MASTER flag and whose mapping has
     no "Master Source" property, which is the shape that made the generator
     drop the join entirely before the symmetric-inner-join fix. The join
     type is INNER, so master/detail direction cannot change the result and
     the join must still be applied.

     Also covers, deliberately:
       - a join condition written master-port-first (ORDER_COUNT_D is fed by
         the SECOND input), so orientation must come from the CONNECTORs
         rather than from the written order;
       - a column rename on the way into the Joiner (TEAM_ID -> TEAM_ID_D),
         so the join must read the renamed copy rather than the raw input;
       - an Aggregator downstream, so a dropped join shows up as a wrong
         aggregate rather than an error. -->
<POWERMART CREATION_DATE="10/03/2026" REPOSITORY_VERSION="189.96">
<REPOSITORY NAME="REP_PEOPLE" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="PEOPLE_DM" OWNER="dev" SHARED="NOTSHARED" DESCRIPTION="Headcount datamart">

<SOURCE NAME="staff" DBDNAME="HRDB" OWNERNAME="HR" DATABASETYPE="Oracle" DESCRIPTION="Staff records">
  <SOURCEFIELD NAME="STAFF_ID"   DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="FULL_NAME"  DATATYPE="varchar2" PRECISION="101" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="SALARY"     DATATYPE="number"   PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="TEAM_ID"    DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="ACTIVE_FLG" DATATYPE="varchar2" PRECISION="1" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<SOURCE NAME="teams" DBDNAME="HRDB" OWNERNAME="HR" DATABASETYPE="Oracle" DESCRIPTION="Team reference">
  <SOURCEFIELD NAME="TEAM_ID"   DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="TEAM_NAME" DATATYPE="varchar2" PRECISION="100" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<TARGET NAME="team_headcount" DATABASETYPE="Oracle" DBDNAME="DMDB" OWNERNAME="DM" DESCRIPTION="Headcount by team">
  <TARGETFIELD NAME="TEAM_NAME"    DATATYPE="varchar2" PRECISION="100" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="STAFF_COUNT"  DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="TOTAL_SALARY" DATATYPE="number"   PRECISION="15" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="AVG_SALARY"   DATATYPE="number"   PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="MIN_SALARY"   DATATYPE="number"   PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="MAX_SALARY"   DATATYPE="number"   PRECISION="12" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>

<MAPPING NAME="m_team_headcount" DESCRIPTION="Join staff to teams and roll up headcount" ISVALID="YES">

  <INSTANCE NAME="staff" TYPE="SOURCE" TRANSFORMATION_NAME="staff" TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="teams" TYPE="SOURCE" TRANSFORMATION_NAME="teams" TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="team_headcount" TYPE="TARGET" TRANSFORMATION_NAME="team_headcount" TRANSFORMATION_TYPE="Target Definition"/>

  <TRANSFORMATION NAME="SQ_staff" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="STAFF_ID"   DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="FULL_NAME"  DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="SALARY"     DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TEAM_ID"    DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="ACTIVE_FLG" DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="SQ_teams" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="TEAM_ID"   DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TEAM_NAME" DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="FIL_active" TYPE="Filter">
    <TRANSFORMFIELD NAME="STAFF_ID"   DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="FULL_NAME"  DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="SALARY"     DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TEAM_ID"    DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="ACTIVE_FLG" DATATYPE="varchar2" PORTTYPE="INPUT"/>
    <TABLEATTRIBUTE NAME="Filter Condition" VALUE="ACTIVE_FLG = 'Y'"/>
  </TRANSFORMATION>

  <!-- No port carries MASTER, and there is no "Master Source" attribute.
       The join type is INNER, so the direction is irrelevant. -->
  <TRANSFORMATION NAME="JNR_staff_team" TYPE="Joiner" DESCRIPTION="Join staff to teams">
    <TRANSFORMFIELD NAME="STAFF_ID"   DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="FULL_NAME"  DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="SALARY"     DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TEAM_ID"    DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TEAM_NAME"  DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TEAM_ID_D"  DATATYPE="number"   PORTTYPE="INPUT"/>
    <TABLEATTRIBUTE NAME="Join Condition" VALUE="TEAM_ID = TEAM_ID_D"/>
    <TABLEATTRIBUTE NAME="Join Type" VALUE="INNER"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="AGG_team_salary" TYPE="Aggregator">
    <TRANSFORMFIELD NAME="TEAM_NAME"    DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT GROUP BY" EXPRESSION="TEAM_NAME"/>
    <TRANSFORMFIELD NAME="STAFF_ID"     DATATYPE="number"   PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="SALARY"       DATATYPE="number"   PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="STAFF_COUNT"  DATATYPE="number"   PORTTYPE="OUTPUT" EXPRESSION="COUNT(STAFF_ID)"/>
    <TRANSFORMFIELD NAME="TOTAL_SALARY" DATATYPE="number"   PORTTYPE="OUTPUT" EXPRESSION="SUM(SALARY)"/>
    <TRANSFORMFIELD NAME="AVG_SALARY"   DATATYPE="number"   PORTTYPE="OUTPUT" EXPRESSION="AVG(SALARY)"/>
    <TRANSFORMFIELD NAME="MIN_SALARY"   DATATYPE="number"   PORTTYPE="OUTPUT" EXPRESSION="MIN(SALARY)"/>
    <TRANSFORMFIELD NAME="MAX_SALARY"   DATATYPE="number"   PORTTYPE="OUTPUT" EXPRESSION="MAX(SALARY)"/>
    <TABLEATTRIBUTE NAME="Group By" VALUE="TEAM_NAME"/>
  </TRANSFORMATION>

  <CONNECTOR FROMINSTANCE="staff" FROMFIELD="STAFF_ID"   TOINSTANCE="SQ_staff" TOFIELD="STAFF_ID"/>
  <CONNECTOR FROMINSTANCE="staff" FROMFIELD="FULL_NAME"  TOINSTANCE="SQ_staff" TOFIELD="FULL_NAME"/>
  <CONNECTOR FROMINSTANCE="staff" FROMFIELD="SALARY"     TOINSTANCE="SQ_staff" TOFIELD="SALARY"/>
  <CONNECTOR FROMINSTANCE="staff" FROMFIELD="TEAM_ID"    TOINSTANCE="SQ_staff" TOFIELD="TEAM_ID"/>
  <CONNECTOR FROMINSTANCE="staff" FROMFIELD="ACTIVE_FLG" TOINSTANCE="SQ_staff" TOFIELD="ACTIVE_FLG"/>

  <CONNECTOR FROMINSTANCE="teams" FROMFIELD="TEAM_ID"   TOINSTANCE="SQ_teams" TOFIELD="TEAM_ID"/>
  <CONNECTOR FROMINSTANCE="teams" FROMFIELD="TEAM_NAME" TOINSTANCE="SQ_teams" TOFIELD="TEAM_NAME"/>

  <CONNECTOR FROMINSTANCE="SQ_staff" FROMFIELD="STAFF_ID"   TOINSTANCE="FIL_active" TOFIELD="STAFF_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_staff" FROMFIELD="FULL_NAME"  TOINSTANCE="FIL_active" TOFIELD="FULL_NAME"/>
  <CONNECTOR FROMINSTANCE="SQ_staff" FROMFIELD="SALARY"     TOINSTANCE="FIL_active" TOFIELD="SALARY"/>
  <CONNECTOR FROMINSTANCE="SQ_staff" FROMFIELD="TEAM_ID"    TOINSTANCE="FIL_active" TOFIELD="TEAM_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_staff" FROMFIELD="ACTIVE_FLG" TOINSTANCE="FIL_active" TOFIELD="ACTIVE_FLG"/>

  <!-- Detail side -->
  <CONNECTOR FROMINSTANCE="FIL_active" FROMFIELD="STAFF_ID"  TOINSTANCE="JNR_staff_team" TOFIELD="STAFF_ID"/>
  <CONNECTOR FROMINSTANCE="FIL_active" FROMFIELD="FULL_NAME" TOINSTANCE="JNR_staff_team" TOFIELD="FULL_NAME"/>
  <CONNECTOR FROMINSTANCE="FIL_active" FROMFIELD="SALARY"    TOINSTANCE="JNR_staff_team" TOFIELD="SALARY"/>
  <CONNECTOR FROMINSTANCE="FIL_active" FROMFIELD="TEAM_ID"   TOINSTANCE="JNR_staff_team" TOFIELD="TEAM_ID"/>
  <!-- Second side: feeds TEAM_NAME and the renamed key port TEAM_ID_D -->
  <CONNECTOR FROMINSTANCE="SQ_teams" FROMFIELD="TEAM_NAME" TOINSTANCE="JNR_staff_team" TOFIELD="TEAM_NAME"/>
  <CONNECTOR FROMINSTANCE="SQ_teams" FROMFIELD="TEAM_ID"   TOINSTANCE="JNR_staff_team" TOFIELD="TEAM_ID_D"/>

  <CONNECTOR FROMINSTANCE="JNR_staff_team" FROMFIELD="TEAM_NAME" TOINSTANCE="AGG_team_salary" TOFIELD="TEAM_NAME"/>
  <CONNECTOR FROMINSTANCE="JNR_staff_team" FROMFIELD="STAFF_ID"  TOINSTANCE="AGG_team_salary" TOFIELD="STAFF_ID"/>
  <CONNECTOR FROMINSTANCE="JNR_staff_team" FROMFIELD="SALARY"    TOINSTANCE="AGG_team_salary" TOFIELD="SALARY"/>

  <CONNECTOR FROMINSTANCE="AGG_team_salary" FROMFIELD="TEAM_NAME"    TOINSTANCE="team_headcount" TOFIELD="TEAM_NAME"/>
  <CONNECTOR FROMINSTANCE="AGG_team_salary" FROMFIELD="STAFF_COUNT"  TOINSTANCE="team_headcount" TOFIELD="STAFF_COUNT"/>
  <CONNECTOR FROMINSTANCE="AGG_team_salary" FROMFIELD="TOTAL_SALARY" TOINSTANCE="team_headcount" TOFIELD="TOTAL_SALARY"/>
  <CONNECTOR FROMINSTANCE="AGG_team_salary" FROMFIELD="AVG_SALARY"   TOINSTANCE="team_headcount" TOFIELD="AVG_SALARY"/>
  <CONNECTOR FROMINSTANCE="AGG_team_salary" FROMFIELD="MIN_SALARY"   TOINSTANCE="team_headcount" TOFIELD="MIN_SALARY"/>
  <CONNECTOR FROMINSTANCE="AGG_team_salary" FROMFIELD="MAX_SALARY"   TOINSTANCE="team_headcount" TOFIELD="MAX_SALARY"/>
</MAPPING>

<SESSION NAME="s_m_team_headcount" MAPPINGNAME="m_team_headcount" DESCRIPTION="Load headcount datamart" ISVALID="YES" REUSABLE="NO">
  <CONNECTIONREFERENCE CONNECTIONNAME="HRDB_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Source" INSTANCENAME="staff" COMPONENTNAME="Source Qualifier Reader"/>
  <CONNECTIONREFERENCE CONNECTIONNAME="DMDB_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Target" INSTANCENAME="team_headcount" COMPONENTNAME="Target Writer"/>
</SESSION>

</FOLDER>
</REPOSITORY>
</POWERMART>
