<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_seq_router" DESCRIPTION="Sequence Generator feeding a Router">
    <SOURCE NAME="ORDERS" DBDNAME="OLTP" OWNERNAME="APP" DATABASETYPE="Oracle">
        <SOURCEFIELD NAME="ORDER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_BIG_ORDERS" DATABASETYPE="Oracle" DBDNAME="DW" OWNERNAME="ANALYTICS">
        <TARGETFIELD NAME="SURROGATE_KEY" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="ORDER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="ORDERS" TYPE="SOURCE" TRANSFORMATION_NAME="ORDERS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_BIG_ORDERS" TYPE="TARGET" TRANSFORMATION_NAME="TGT_BIG_ORDERS" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_ORDERS" TYPE="Source Qualifier">
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="SEQ_KEYS" TYPE="Sequence Generator">
        <TRANSFORMFIELD NAME="NEXTVAL" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TABLEATTRIBUTE NAME="Start Value" VALUE="1"/>
        <TABLEATTRIBUTE NAME="Increment By" VALUE="1"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="RTR_SIZE" TYPE="Router">
        <GROUP NAME="big" CONDITION="AMOUNT &gt; 1000"/>
        <GROUP NAME="small"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="SURROGATE_KEY" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="SQ_ORDERS" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="AMOUNT" TOINSTANCE="SQ_ORDERS" TOFIELD="AMOUNT"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="RTR_SIZE" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="AMOUNT" TOINSTANCE="RTR_SIZE" TOFIELD="AMOUNT"/>
    <CONNECTOR FROMINSTANCE="SEQ_KEYS" FROMFIELD="NEXTVAL" TOINSTANCE="RTR_SIZE" TOFIELD="SURROGATE_KEY"/>
    <CONNECTOR FROMINSTANCE="RTR_SIZE" FROMFIELD="SURROGATE_KEY" TOINSTANCE="TGT_BIG_ORDERS" TOFIELD="SURROGATE_KEY"/>
    <CONNECTOR FROMINSTANCE="RTR_SIZE" FROMFIELD="ORDER_ID" TOINSTANCE="TGT_BIG_ORDERS" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="RTR_SIZE" FROMFIELD="AMOUNT" TOINSTANCE="TGT_BIG_ORDERS" TOFIELD="AMOUNT"/>
</MAPPING>
