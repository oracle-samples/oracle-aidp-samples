<MAPPLET DESCRIPTION="Standardise a phone number and an e-mail address" ISVALID="YES" NAME="mplt_clean_contact" OBJECTVERSION="1" VERSIONNUMBER="1">
    <TRANSFORMATION DESCRIPTION="" NAME="INPUT_CONTACT" OBJECTVERSION="1" REUSABLE="NO" TYPE="Input Transformation" VERSIONNUMBER="1">
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" MAPPLETGROUP="Input" NAME="IN_PHONE" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="30" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" MAPPLETGROUP="Input" NAME="IN_EMAIL" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="80" SCALE="0"/>
    </TRANSFORMATION>
    <TRANSFORMATION DESCRIPTION="" NAME="EXP_CLEAN_CONTACT" OBJECTVERSION="1" REUSABLE="NO" TYPE="Expression" VERSIONNUMBER="1">
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" EXPRESSION="IN_PHONE" EXPRESSIONTYPE="GENERAL" NAME="IN_PHONE" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="30" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" EXPRESSION="IN_EMAIL" EXPRESSIONTYPE="GENERAL" NAME="IN_EMAIL" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="80" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" EXPRESSION="REPLACECHR(0, IN_PHONE, '()- .', NULL)" EXPRESSIONTYPE="GENERAL" NAME="OUT_PHONE" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="30" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" EXPRESSION="LOWER(LTRIM(RTRIM(IN_EMAIL)))" EXPRESSIONTYPE="GENERAL" NAME="OUT_EMAIL" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="80" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" EXPRESSION="IIF(ISNULL(IN_PHONE), 'N', 'Y')" EXPRESSIONTYPE="GENERAL" NAME="PHONE_FLAG" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="1" SCALE="0"/>
        <TABLEATTRIBUTE NAME="Tracing Level" VALUE="Normal"/>
    </TRANSFORMATION>
    <TRANSFORMATION DESCRIPTION="" NAME="OUTPUT_CONTACT" OBJECTVERSION="1" REUSABLE="NO" TYPE="Output Transformation" VERSIONNUMBER="1">
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" MAPPLETGROUP="Output" NAME="OUT_PHONE" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="30" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" MAPPLETGROUP="Output" NAME="OUT_EMAIL" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="80" SCALE="0"/>
        <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" MAPPLETGROUP="Output" NAME="PHONE_FLAG" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="1" SCALE="0"/>
    </TRANSFORMATION>
