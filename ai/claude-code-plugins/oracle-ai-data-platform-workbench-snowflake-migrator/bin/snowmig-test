#!/usr/bin/env bash
# snowmig-test — run the engine's test suite. CREATES NO FOLDERS.
#
# Same rule as `snowmig`: use the current interpreter when it can already run
# the suite, otherwise build a throwaway venv under $TMPDIR and delete it on
# exit. Nothing persists between runs.
#
# Collection is scoped by the plugin-root pytest.ini, so this never picks up
# the neighbouring samples in the monorepo.
#
#   snowmig-test [pytest args...]
set -euo pipefail
# No __pycache__ beside the plugin: bytecode is not written.
export PYTHONDONTWRITEBYTECODE=1

PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
REQUIREMENTS="${PLUGIN_ROOT}/engine/requirements.txt"
DEV_REQUIREMENTS="${PLUGIN_ROOT}/engine/requirements-dev.txt"

die() { printf 'snowmig-test: %s\n' "$1" >&2; exit 1; }

can_test() { "$1" -c 'import pytest, yaml, snowflake.connector' >/dev/null 2>&1; }

PY=""
for candidate in "${SNOWMIG_PYTHON:-}" python3 python3.14 python3.13 python3.12 python3.11 python3.10 python; do
  [ -n "${candidate}" ] || continue
  command -v "${candidate}" >/dev/null 2>&1 || continue
  if can_test "${candidate}"; then PY="${candidate}"; break; fi
done

if [ -z "${PY}" ]; then
  base=""
  for candidate in "${SNOWMIG_PYTHON:-}" python3.13 python3.12 python3.11 python3.14 python3.10 python3 python; do
    [ -n "${candidate}" ] || continue
    command -v "${candidate}" >/dev/null 2>&1 || continue
    if "${candidate}" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      base="${candidate}"; break
    fi
  done
  [ -n "${base}" ] || die "no python3 >= 3.10 on PATH"

  SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/snowmig-test.XXXXXXXX")"
  trap 'rm -rf "${SCRATCH}"' EXIT INT TERM
  printf 'snowmig-test: building a throwaway environment (removed on exit)\n' >&2
  # The venv module's own message (Debian prints it on stdout) says why.
  "${base}" -m venv "${SCRATCH}/venv" >&2 \
    || die "could not create a temporary venv (on Debian/Ubuntu: apt install python3-venv)"
  PY="${SCRATCH}/venv/bin/python"
  # A venv on Windows (Git Bash) puts the interpreter under Scripts/.
  [ -x "${PY}" ] || PY="${SCRATCH}/venv/Scripts/python.exe"
  "${PY}" -m pip install --quiet --upgrade pip >/dev/null 2>&1 || true
  for req in "${REQUIREMENTS}" "${DEV_REQUIREMENTS}"; do
    [ -f "${req}" ] || continue
    "${PY}" -m pip install --quiet -r "${req}" || die "installing ${req} failed"
  done
  "${PY}" -m pip install --quiet pytest >/dev/null 2>&1 || true
  can_test "${PY}" || die "the temporary environment cannot import pytest and the engine deps"
fi

cd "${PLUGIN_ROOT}"
# No .pytest_cache beside the plugin (this drops --lf/--ff).
"${PY}" -m pytest -p no:cacheprovider "$@"
