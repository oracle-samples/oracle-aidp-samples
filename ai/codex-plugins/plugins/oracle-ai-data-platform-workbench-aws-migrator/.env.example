# AWS (source)
AWS_PROFILE=default
AWS_REGION=us-east-1

# OCI / AIDP (destination — only needed for plan / migrate / verify)
OCI_PROFILE=DEFAULT
OCI_REGION=ap-mumbai-1
DATALAKE_OCID=
WORKSPACE_ID=

# Optional route selection for live AIDP calls. Leave both unset for the
# GA 20260430 commercial-realm endpoint. AIDP_ENDPOINT is the complete
# versioned collection root (for example https://host/20240831/dataLakes) and
# must not be combined with AIDP_API_VERSION.
# AIDP_API_VERSION=20260430
# AIDP_ENDPOINT=

# Default OCI Object Storage namespace for S3 → OCI translation
# Find yours with: oci os ns get
OCI_NAMESPACE=
