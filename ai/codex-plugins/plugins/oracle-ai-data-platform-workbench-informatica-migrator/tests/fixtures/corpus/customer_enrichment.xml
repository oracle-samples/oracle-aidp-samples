<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_customer_enrichment" DESCRIPTION="Enrich customer data with derived columns">
    <SOURCE NAME="CUSTOMERS" DBDNAME="CRM_DB" OWNERNAME="CRM" DATABASETYPE="Oracle" DESCRIPTION="Customer master source">
        <SOURCEFIELD NAME="CUST_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="FIRST_NAME" DATATYPE="string" PRECISION="60" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="LAST_NAME" DATATYPE="string" PRECISION="60" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="EMAIL" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="BIRTH_DATE" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="COUNTRY" DATATYPE="string" PRECISION="2" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_CUSTOMERS_ENRICHED" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Enriched customer dimension">
        <TARGETFIELD NAME="CUST_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="FULL_NAME" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="EMAIL" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="IS_EU_CUSTOMER" DATATYPE="integer" PRECISION="1" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="CUSTOMERS" TYPE="SOURCE" TRANSFORMATION_NAME="CUSTOMERS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_CUSTOMERS_ENRICHED" TYPE="TARGET" TRANSFORMATION_NAME="TGT_CUSTOMERS_ENRICHED" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_CUSTOMERS" TYPE="Source Qualifier">
        <TRANSFORMFIELD NAME="CUST_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_NAME" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="LAST_NAME" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="EMAIL" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="BIRTH_DATE" DATATYPE="date" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="COUNTRY" DATATYPE="string" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_ENRICH" TYPE="Expression">
        <TRANSFORMFIELD NAME="CUST_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="FIRST_NAME" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="LAST_NAME" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="EMAIL" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="BIRTH_DATE" DATATYPE="date" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="COUNTRY" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="FULL_NAME" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="FIRST_NAME || ' ' || LAST_NAME"/>
        <TRANSFORMFIELD NAME="EMAIL_DOMAIN" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="SUBSTR(EMAIL, INSTR(EMAIL, '@') + 1)"/>
        <TRANSFORMFIELD NAME="IS_EU_CUSTOMER" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(COUNTRY IN ('DE', 'FR', 'GB', 'IT', 'ES', 'NL'), 1, 0)"/>
        <TRANSFORMFIELD NAME="LOAD_DATE" DATATYPE="date" PORTTYPE="OUTPUT" EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="FIL_VALID_EMAIL" TYPE="Filter">
        <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(EMAIL) AND LENGTH(EMAIL) > 5"/>
        <TRANSFORMFIELD NAME="CUST_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FULL_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="EMAIL" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="CUSTOMERS" FROMFIELD="CUST_ID" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="CUST_ID"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS" FROMFIELD="FIRST_NAME" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="FIRST_NAME"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS" FROMFIELD="LAST_NAME" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="LAST_NAME"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS" FROMFIELD="EMAIL" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="EMAIL"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS" FROMFIELD="BIRTH_DATE" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="BIRTH_DATE"/>
    <CONNECTOR FROMINSTANCE="CUSTOMERS" FROMFIELD="COUNTRY" TOINSTANCE="SQ_CUSTOMERS" TOFIELD="COUNTRY"/>
    <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="CUST_ID" TOINSTANCE="EXP_ENRICH" TOFIELD="CUST_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="FIRST_NAME" TOINSTANCE="EXP_ENRICH" TOFIELD="FIRST_NAME"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="CUST_ID" TOINSTANCE="FIL_VALID_EMAIL" TOFIELD="CUST_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="FULL_NAME" TOINSTANCE="FIL_VALID_EMAIL" TOFIELD="FULL_NAME"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_EMAIL" FROMFIELD="CUST_ID" TOINSTANCE="TGT_CUSTOMERS_ENRICHED" TOFIELD="CUST_ID"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_EMAIL" FROMFIELD="FULL_NAME" TOINSTANCE="TGT_CUSTOMERS_ENRICHED" TOFIELD="FULL_NAME"/>
    <CONNECTOR FROMINSTANCE="FIL_VALID_EMAIL" FROMFIELD="EMAIL" TOINSTANCE="TGT_CUSTOMERS_ENRICHED" TOFIELD="EMAIL"/>
    <CONNECTOR FROMINSTANCE="EXP_ENRICH" FROMFIELD="IS_EU_CUSTOMER" TOINSTANCE="TGT_CUSTOMERS_ENRICHED" TOFIELD="IS_EU_CUSTOMER"/>
</MAPPING>
