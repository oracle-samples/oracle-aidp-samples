<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_order_to_cash" DESCRIPTION="Order-to-cash pipeline with aggregation">
    <SOURCE NAME="ORDERS" DBDNAME="SALES_DB" OWNERNAME="SALES" DATABASETYPE="Oracle" DESCRIPTION="Order line source">
        <SOURCEFIELD NAME="ORDER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="LINE_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="PAYMENT_STATUS" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="ORDER_DATE" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_CUSTOMER_REVENUE" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Customer revenue summary">
        <TARGETFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="TOTAL_REVENUE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="ORDER_COUNT" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="SEGMENT" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="ORDERS" TYPE="SOURCE" TRANSFORMATION_NAME="ORDERS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_CUSTOMER_REVENUE" TYPE="TARGET" TRANSFORMATION_NAME="TGT_CUSTOMER_REVENUE" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_ORDERS" TYPE="Source Qualifier">
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="LINE_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="PAYMENT_STATUS" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="ORDER_DATE" DATATYPE="date" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="FIL_PAID" TYPE="Filter">
        <TABLEATTRIBUTE NAME="Filter Condition" VALUE="PAYMENT_STATUS = 'PAID'"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="LINE_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="ORDER_DATE" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="AGG_REVENUE" TYPE="Aggregator">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="LINE_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_REVENUE" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="SUM(LINE_AMOUNT)"/>
        <TRANSFORMFIELD NAME="ORDER_COUNT" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="COUNT(ORDER_ID)"/>
        <TRANSFORMFIELD NAME="AVG_ORDER_VALUE" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="AVG(LINE_AMOUNT)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_SEGMENT" TYPE="Expression">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_REVENUE" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="SEGMENT" DATATYPE="string" PORTTYPE="OUTPUT" EXPRESSION="IIF(TOTAL_REVENUE > 10000, 'PLATINUM', IIF(TOTAL_REVENUE > 1000, 'GOLD', 'STANDARD'))"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="SQ_ORDERS" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="CUSTOMER_ID" TOINSTANCE="SQ_ORDERS" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="LINE_AMOUNT" TOINSTANCE="SQ_ORDERS" TOFIELD="LINE_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="PAYMENT_STATUS" TOINSTANCE="SQ_ORDERS" TOFIELD="PAYMENT_STATUS"/>
    <CONNECTOR FROMINSTANCE="ORDERS" FROMFIELD="ORDER_DATE" TOINSTANCE="SQ_ORDERS" TOFIELD="ORDER_DATE"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="ORDER_ID" TOINSTANCE="FIL_PAID" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="CUSTOMER_ID" TOINSTANCE="FIL_PAID" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="LINE_AMOUNT" TOINSTANCE="FIL_PAID" TOFIELD="LINE_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="FIL_PAID" FROMFIELD="CUSTOMER_ID" TOINSTANCE="AGG_REVENUE" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="FIL_PAID" FROMFIELD="LINE_AMOUNT" TOINSTANCE="AGG_REVENUE" TOFIELD="LINE_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="AGG_REVENUE" FROMFIELD="CUSTOMER_ID" TOINSTANCE="EXP_SEGMENT" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="AGG_REVENUE" FROMFIELD="TOTAL_REVENUE" TOINSTANCE="EXP_SEGMENT" TOFIELD="TOTAL_REVENUE"/>
    <CONNECTOR FROMINSTANCE="EXP_SEGMENT" FROMFIELD="CUSTOMER_ID" TOINSTANCE="TGT_CUSTOMER_REVENUE" TOFIELD="CUSTOMER_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_SEGMENT" FROMFIELD="SEGMENT" TOINSTANCE="TGT_CUSTOMER_REVENUE" TOFIELD="SEGMENT"/>
    <CONNECTOR FROMINSTANCE="AGG_REVENUE" FROMFIELD="TOTAL_REVENUE" TOINSTANCE="TGT_CUSTOMER_REVENUE" TOFIELD="TOTAL_REVENUE"/>
    <CONNECTOR FROMINSTANCE="AGG_REVENUE" FROMFIELD="ORDER_COUNT" TOINSTANCE="TGT_CUSTOMER_REVENUE" TOFIELD="ORDER_COUNT"/>
</MAPPING>
