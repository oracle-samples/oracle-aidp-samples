<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_time_series_rollup" DESCRIPTION="Hourly rollup of sensor readings into daily summaries">
    <SOURCE NAME="SENSOR_READINGS" DBDNAME="IOT_DB" OWNERNAME="TELEMETRY" DATABASETYPE="Oracle" DESCRIPTION="Raw sensor reading events">
        <SOURCEFIELD NAME="SENSOR_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="READING_VALUE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="READING_TS" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_DAILY_SENSOR_STATS" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Daily sensor reading rollup">
        <TARGETFIELD NAME="SENSOR_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="READING_DATE" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="MIN_VALUE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="MAX_VALUE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="AVG_VALUE" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="READING_COUNT" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="SENSOR_READINGS" TYPE="SOURCE" TRANSFORMATION_NAME="SENSOR_READINGS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_DAILY_SENSOR_STATS" TYPE="TARGET" TRANSFORMATION_NAME="TGT_DAILY_SENSOR_STATS" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_SENSOR_READINGS" TYPE="Source Qualifier">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT SENSOR_ID, READING_VALUE, READING_TS FROM SENSOR_READINGS WHERE READING_TS >= :START_DATE"/>
        <TRANSFORMFIELD NAME="SENSOR_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="READING_VALUE" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="READING_TS" DATATYPE="date" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_EXTRACT_DATE" TYPE="Expression">
        <TRANSFORMFIELD NAME="SENSOR_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="READING_VALUE" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="READING_TS" DATATYPE="date" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="READING_DATE" DATATYPE="date" PORTTYPE="OUTPUT" EXPRESSION="TO_DATE(READING_TS, 'YYYY-MM-DD')"/>
        <TRANSFORMFIELD NAME="HOUR_BUCKET" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="TO_INTEGER(SUBSTR(TO_CHAR(READING_TS, 'HH24'), 1, 2))"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="SRT_BY_DATE" TYPE="Sorter">
        <SORTKEY NAME="READING_DATE" DIRECTION="ASC"/>
        <SORTKEY NAME="SENSOR_ID" DIRECTION="ASC"/>
        <TRANSFORMFIELD NAME="SENSOR_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="READING_DATE" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="READING_VALUE" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="AGG_DAILY_STATS" TYPE="Aggregator">
        <TRANSFORMFIELD NAME="SENSOR_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="READING_DATE" DATATYPE="date" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="READING_VALUE" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="MIN_VALUE" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="MIN(READING_VALUE)"/>
        <TRANSFORMFIELD NAME="MAX_VALUE" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="MAX(READING_VALUE)"/>
        <TRANSFORMFIELD NAME="AVG_VALUE" DATATYPE="decimal" PORTTYPE="OUTPUT" EXPRESSION="AVG(READING_VALUE)"/>
        <TRANSFORMFIELD NAME="READING_COUNT" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="COUNT(*)"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="SENSOR_READINGS" FROMFIELD="SENSOR_ID" TOINSTANCE="SQ_SENSOR_READINGS" TOFIELD="SENSOR_ID"/>
    <CONNECTOR FROMINSTANCE="SENSOR_READINGS" FROMFIELD="READING_VALUE" TOINSTANCE="SQ_SENSOR_READINGS" TOFIELD="READING_VALUE"/>
    <CONNECTOR FROMINSTANCE="SENSOR_READINGS" FROMFIELD="READING_TS" TOINSTANCE="SQ_SENSOR_READINGS" TOFIELD="READING_TS"/>
    <CONNECTOR FROMINSTANCE="SQ_SENSOR_READINGS" FROMFIELD="SENSOR_ID" TOINSTANCE="EXP_EXTRACT_DATE" TOFIELD="SENSOR_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_SENSOR_READINGS" FROMFIELD="READING_VALUE" TOINSTANCE="EXP_EXTRACT_DATE" TOFIELD="READING_VALUE"/>
    <CONNECTOR FROMINSTANCE="SQ_SENSOR_READINGS" FROMFIELD="READING_TS" TOINSTANCE="EXP_EXTRACT_DATE" TOFIELD="READING_TS"/>
    <CONNECTOR FROMINSTANCE="EXP_EXTRACT_DATE" FROMFIELD="SENSOR_ID" TOINSTANCE="SRT_BY_DATE" TOFIELD="SENSOR_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_EXTRACT_DATE" FROMFIELD="READING_DATE" TOINSTANCE="SRT_BY_DATE" TOFIELD="READING_DATE"/>
    <CONNECTOR FROMINSTANCE="EXP_EXTRACT_DATE" FROMFIELD="READING_VALUE" TOINSTANCE="SRT_BY_DATE" TOFIELD="READING_VALUE"/>
    <CONNECTOR FROMINSTANCE="SRT_BY_DATE" FROMFIELD="SENSOR_ID" TOINSTANCE="AGG_DAILY_STATS" TOFIELD="SENSOR_ID"/>
    <CONNECTOR FROMINSTANCE="SRT_BY_DATE" FROMFIELD="READING_DATE" TOINSTANCE="AGG_DAILY_STATS" TOFIELD="READING_DATE"/>
    <CONNECTOR FROMINSTANCE="SRT_BY_DATE" FROMFIELD="READING_VALUE" TOINSTANCE="AGG_DAILY_STATS" TOFIELD="READING_VALUE"/>
    <CONNECTOR FROMINSTANCE="AGG_DAILY_STATS" FROMFIELD="SENSOR_ID" TOINSTANCE="TGT_DAILY_SENSOR_STATS" TOFIELD="SENSOR_ID"/>
    <CONNECTOR FROMINSTANCE="AGG_DAILY_STATS" FROMFIELD="MIN_VALUE" TOINSTANCE="TGT_DAILY_SENSOR_STATS" TOFIELD="MIN_VALUE"/>
    <CONNECTOR FROMINSTANCE="AGG_DAILY_STATS" FROMFIELD="READING_DATE" TOINSTANCE="TGT_DAILY_SENSOR_STATS" TOFIELD="READING_DATE"/>
    <CONNECTOR FROMINSTANCE="AGG_DAILY_STATS" FROMFIELD="MAX_VALUE" TOINSTANCE="TGT_DAILY_SENSOR_STATS" TOFIELD="MAX_VALUE"/>
    <CONNECTOR FROMINSTANCE="AGG_DAILY_STATS" FROMFIELD="AVG_VALUE" TOINSTANCE="TGT_DAILY_SENSOR_STATS" TOFIELD="AVG_VALUE"/>
    <CONNECTOR FROMINSTANCE="AGG_DAILY_STATS" FROMFIELD="READING_COUNT" TOINSTANCE="TGT_DAILY_SENSOR_STATS" TOFIELD="READING_COUNT"/>
</MAPPING>
