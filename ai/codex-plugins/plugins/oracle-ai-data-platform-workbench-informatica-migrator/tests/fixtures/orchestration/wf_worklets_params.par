[Global]
$$ENV=PROD
$$BATCH_SIZE=5000

[SALES_DM.WF:wf_sales_nightly]
$$RUN_REGION=ALL
$$BATCH_SIZE=10000
$DBConnection_SRC=ORA_SALES_PROD

[SALES_DM.WF:wf_sales_nightly.WT:wl_dims]
$$DIM_SCOPE=FULL

[SALES_DM.WF:wf_sales_nightly.WT:wl_dims.ST:s_dim_customer]
$$DIM_NAME=CUSTOMER
$$SRC_TABLE=CRM.CUSTOMERS

[SALES_DM.WF:wf_sales_nightly.WT:wl_dims.ST:s_dim_product]
$$DIM_NAME=PRODUCT
$$SRC_TABLE=ERP.PRODUCTS
$InputFile_Products=/data/in/products.dat

[SALES_DM.WF:wf_sales_nightly.ST:s_m_load_fact]
$$LOAD_TYPE=INCREMENTAL
$$RUN_REGION=EMEA

[SALES_DM.WF:wf_other.ST:s_m_load_fact]
$$LOAD_TYPE=IGNORED_OTHER_WORKFLOW
