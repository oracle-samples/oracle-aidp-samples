<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_debezium_upsert" DESCRIPTION="Process Debezium CDC events: INSERT/UPDATE/DELETE routing">
    <SOURCE NAME="CDC_ORDERS_EVENTS" DBDNAME="CDC_STREAM" OWNERNAME="STAGING" DATABASETYPE="Oracle" DESCRIPTION="Debezium CDC event stream for orders">
        <SOURCEFIELD NAME="OP" DATATYPE="string" PRECISION="1" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="BEFORE_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="AFTER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="AFTER_NAME" DATATYPE="string" PRECISION="60" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="AFTER_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="AFTER_STATUS" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="TS_MS" DATATYPE="integer" PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_ORDERS_CDC" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Upserted order state after CDC routing">
        <TARGETFIELD NAME="ORDER_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="AFTER_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="AFTER_STATUS" DATATYPE="string" PRECISION="20" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="EVENT_TS" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="CDC_ORDERS_EVENTS" TYPE="SOURCE" TRANSFORMATION_NAME="CDC_ORDERS_EVENTS" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_ORDERS_CDC" TYPE="TARGET" TRANSFORMATION_NAME="TGT_ORDERS_CDC" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_CDC_EVENTS" TYPE="Source Qualifier">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT OP, BEFORE_ID, AFTER_ID, AFTER_NAME, AFTER_AMOUNT, AFTER_STATUS, TS_MS FROM CDC_ORDERS_EVENTS"/>
        <TRANSFORMFIELD NAME="OP" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="BEFORE_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="AFTER_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="AFTER_NAME" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="AFTER_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="AFTER_STATUS" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="TS_MS" DATATYPE="integer" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_NORMALIZE" TYPE="Expression">
        <TRANSFORMFIELD NAME="OP" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="AFTER_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="AFTER_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="TS_MS" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(ISNULL(AFTER_ID), BEFORE_ID, AFTER_ID)"/>
        <TRANSFORMFIELD NAME="EVENT_TS" DATATYPE="date" PORTTYPE="OUTPUT" EXPRESSION="TO_DATE(TS_MS / 1000, 'UNIXTIME')"/>
        <TRANSFORMFIELD NAME="IS_DELETE" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(OP = 'd', 1, 0)"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="RTR_CDC_OP" TYPE="Router">
        <GROUP NAME="inserts" CONDITION="OP = 'c'"/>
        <GROUP NAME="updates" CONDITION="OP = 'u'"/>
        <GROUP NAME="deletes" CONDITION="OP = 'd'"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="AFTER_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="AFTER_STATUS" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="EVENT_TS" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="OP" DATATYPE="string" PORTTYPE="INPUT"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="OP" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="OP"/>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="BEFORE_ID" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="BEFORE_ID"/>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="AFTER_ID" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="AFTER_ID"/>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="AFTER_NAME" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="AFTER_NAME"/>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="AFTER_AMOUNT" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="AFTER_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="AFTER_STATUS" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="AFTER_STATUS"/>
    <CONNECTOR FROMINSTANCE="CDC_ORDERS_EVENTS" FROMFIELD="TS_MS" TOINSTANCE="SQ_CDC_EVENTS" TOFIELD="TS_MS"/>
    <CONNECTOR FROMINSTANCE="SQ_CDC_EVENTS" FROMFIELD="OP" TOINSTANCE="EXP_NORMALIZE" TOFIELD="OP"/>
    <CONNECTOR FROMINSTANCE="SQ_CDC_EVENTS" FROMFIELD="AFTER_ID" TOINSTANCE="EXP_NORMALIZE" TOFIELD="AFTER_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_CDC_EVENTS" FROMFIELD="TS_MS" TOINSTANCE="EXP_NORMALIZE" TOFIELD="TS_MS"/>
    <CONNECTOR FROMINSTANCE="EXP_NORMALIZE" FROMFIELD="ORDER_ID" TOINSTANCE="RTR_CDC_OP" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_NORMALIZE" FROMFIELD="OP" TOINSTANCE="RTR_CDC_OP" TOFIELD="OP"/>
    <CONNECTOR FROMINSTANCE="SQ_CDC_EVENTS" FROMFIELD="AFTER_AMOUNT" TOINSTANCE="RTR_CDC_OP" TOFIELD="AFTER_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="SQ_CDC_EVENTS" FROMFIELD="AFTER_STATUS" TOINSTANCE="RTR_CDC_OP" TOFIELD="AFTER_STATUS"/>
    <CONNECTOR FROMINSTANCE="RTR_CDC_OP" FROMFIELD="ORDER_ID" TOINSTANCE="TGT_ORDERS_CDC" TOFIELD="ORDER_ID"/>
    <CONNECTOR FROMINSTANCE="RTR_CDC_OP" FROMFIELD="AFTER_AMOUNT" TOINSTANCE="TGT_ORDERS_CDC" TOFIELD="AFTER_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="RTR_CDC_OP" FROMFIELD="AFTER_STATUS" TOINSTANCE="TGT_ORDERS_CDC" TOFIELD="AFTER_STATUS"/>
    <CONNECTOR FROMINSTANCE="RTR_CDC_OP" FROMFIELD="EVENT_TS" TOINSTANCE="TGT_ORDERS_CDC" TOFIELD="EVENT_TS"/>
</MAPPING>
