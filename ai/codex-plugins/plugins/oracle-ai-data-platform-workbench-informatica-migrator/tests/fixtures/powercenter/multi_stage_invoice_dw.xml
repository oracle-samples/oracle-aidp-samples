<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored for this project.

     A three-stage warehouse load in one export — the staging -> fact ->
     aggregate pattern most PowerCenter estates are built around. It exists to
     cover what a single-mapping fixture cannot:

       - THREE mappings in one file, with a real dependency between them:
         m_load_invoice_fact reads stg_invoice_txn, which m_stage_invoice_txn
         writes. Dependency detection has to find that through the tables, not
         through any declared link.
       - a Source Qualifier SQL override carrying an incremental predicate on
         LAST_UPDATE_DATE
       - an Expression using IIF
       - a Filter
       - a Lookup in the first mapping and TWO in the second
       - an Update Strategy using DD_INSERT / DD_UPDATE
       - an Aggregator with a GROUP BY
       - three sessions and a workflow wiring them in order

     Every name here is generic: a party/unit/invoice warehouse is a universal
     shape, and nothing in this file is taken from any product's shipped
     content. -->
<POWERMART CREATION_DATE="10/03/2026" REPOSITORY_VERSION="188.96">
<REPOSITORY NAME="REP_FIN_DW" VERSION="188" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="FINANCE_DW" OWNER="dev" SHARED="NOTSHARED" DESCRIPTION="Invoice revenue warehouse">

<SOURCE NAME="invoice_txn" DBDNAME="OLTPFIN" OWNERNAME="FIN" DATABASETYPE="Oracle" DESCRIPTION="Invoice transactions">
  <SOURCEFIELD NAME="TXN_ID"            DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="TXN_NUMBER"        DATATYPE="varchar2" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="TXN_DATE"          DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="BILL_TO_PARTY_ID"  DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="UNIT_ID"           DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="INVOICED_AMOUNT"   DATATYPE="number"   PRECISION="18" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="CURRENCY_CODE"     DATATYPE="varchar2" PRECISION="3"  SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="LAST_UPDATE_DATE"  DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<SOURCE NAME="party_master" DBDNAME="OLTPFIN" OWNERNAME="FIN" DATABASETYPE="Oracle" DESCRIPTION="Party reference">
  <SOURCEFIELD NAME="PARTY_ID"   DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="PARTY_NAME" DATATYPE="varchar2" PRECISION="200" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<SOURCE NAME="stg_invoice_txn" DBDNAME="STGFIN" OWNERNAME="STG" DATABASETYPE="Oracle" DESCRIPTION="Staged invoice transactions">
  <SOURCEFIELD NAME="TXN_ID"           DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="TXN_NUMBER"       DATATYPE="varchar2" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="TXN_DATE"         DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="BILL_TO_PARTY_ID" DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="UNIT_ID"          DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="INVOICED_AMOUNT"  DATATYPE="number"   PRECISION="18" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="PARTY_NAME"       DATATYPE="varchar2" PRECISION="200" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<SOURCE NAME="dim_party" DBDNAME="DWFIN" OWNERNAME="DW" DATABASETYPE="Oracle" DESCRIPTION="Party dimension">
  <SOURCEFIELD NAME="PARTY_ID" DATATYPE="number" PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="PARTY_SK" DATATYPE="number" PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
</SOURCE>

<SOURCE NAME="dim_unit" DBDNAME="DWFIN" OWNERNAME="DW" DATABASETYPE="Oracle" DESCRIPTION="Business unit dimension">
  <SOURCEFIELD NAME="UNIT_ID" DATATYPE="number" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="UNIT_SK" DATATYPE="number" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
</SOURCE>

<SOURCE NAME="fct_invoice_txn" DBDNAME="DWFIN" OWNERNAME="DW" DATABASETYPE="Oracle" DESCRIPTION="Invoice fact">
  <SOURCEFIELD NAME="TXN_ID"          DATATYPE="number" PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <SOURCEFIELD NAME="PARTY_SK"        DATATYPE="number" PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="TXN_DATE"        DATATYPE="date"   PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <SOURCEFIELD NAME="INVOICED_AMOUNT" DATATYPE="number" PRECISION="18" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</SOURCE>

<TARGET NAME="stg_invoice_txn" DATABASETYPE="Oracle" DBDNAME="STGFIN" OWNERNAME="STG" DESCRIPTION="Staged invoice transactions">
  <TARGETFIELD NAME="TXN_ID"           DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="TXN_NUMBER"       DATATYPE="varchar2" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="TXN_DATE"         DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="BILL_TO_PARTY_ID" DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="UNIT_ID"          DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="INVOICED_AMOUNT"  DATATYPE="number"   PRECISION="18" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="PARTY_NAME"       DATATYPE="varchar2" PRECISION="200" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>

<TARGET NAME="fct_invoice_txn" DATABASETYPE="Oracle" DBDNAME="DWFIN" OWNERNAME="DW" DESCRIPTION="Invoice fact">
  <TARGETFIELD NAME="TXN_ID"          DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="TXN_NUMBER"      DATATYPE="varchar2" PRECISION="30" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="TXN_DATE"        DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="PARTY_SK"        DATATYPE="number"   PRECISION="15" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="UNIT_SK"         DATATYPE="number"   PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="INVOICED_AMOUNT" DATATYPE="number"   PRECISION="18" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="CHANGE_FLAG"     DATATYPE="varchar2" PRECISION="1"  SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="INSERT_DT"       DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="UPDATE_DT"       DATATYPE="date"     PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>

<TARGET NAME="agg_revenue_monthly" DATABASETYPE="Oracle" DBDNAME="DWFIN" OWNERNAME="DW" DESCRIPTION="Monthly revenue by party">
  <TARGETFIELD NAME="PARTY_SK"      DATATYPE="number" PRECISION="15" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="PERIOD_KEY"    DATATYPE="number" PRECISION="8"  SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
  <TARGETFIELD NAME="TOTAL_REVENUE" DATATYPE="number" PRECISION="20" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
  <TARGETFIELD NAME="TXN_COUNT"     DATATYPE="number" PRECISION="10" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
</TARGET>

<!-- ============ 1. extract to staging ============ -->
<MAPPING NAME="m_stage_invoice_txn" DESCRIPTION="Incremental extract of invoice transactions to staging" ISVALID="YES">
  <MAPPINGVARIABLE NAME="$$LAST_EXTRACT_DATE" DATATYPE="date/time" DEFAULTVALUE="01/01/2026 00:00:00" ISEXPRESSIONVARIABLE="NO"/>
  <MAPPINGVARIABLE NAME="$$DEFAULT_CURRENCY"  DATATYPE="string"    DEFAULTVALUE="USD" ISEXPRESSIONVARIABLE="NO"/>
  <INSTANCE NAME="invoice_txn"     TYPE="SOURCE" TRANSFORMATION_NAME="invoice_txn"     TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="stg_invoice_txn" TYPE="TARGET" TRANSFORMATION_NAME="stg_invoice_txn" TRANSFORMATION_TYPE="Target Definition"/>

  <TRANSFORMATION NAME="SQ_invoice_txn" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="TXN_ID"           DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_NUMBER"       DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"         DATATYPE="date"     PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="BILL_TO_PARTY_ID" DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="UNIT_ID"          DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT"  DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="CURRENCY_CODE"    DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
    <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT TXN_ID, TXN_NUMBER, TXN_DATE, BILL_TO_PARTY_ID, UNIT_ID, INVOICED_AMOUNT, CURRENCY_CODE FROM invoice_txn WHERE LAST_UPDATE_DATE &gt; $$LAST_EXTRACT_DATE"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="EXP_txn_defaults" TYPE="Expression">
    <TRANSFORMFIELD NAME="TXN_ID"              DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_NUMBER"          DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"            DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="BILL_TO_PARTY_ID"    DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="UNIT_ID"             DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT"     DATATYPE="number"   PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="CURRENCY_CODE"       DATATYPE="varchar2" PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT_OUT" DATATYPE="number"   PORTTYPE="OUTPUT" EXPRESSION="IIF(ISNULL(INVOICED_AMOUNT), 0, INVOICED_AMOUNT)"/>
    <TRANSFORMFIELD NAME="CURRENCY_CODE_OUT"   DATATYPE="varchar2" PORTTYPE="OUTPUT" EXPRESSION="IIF(ISNULL(CURRENCY_CODE), '$$DEFAULT_CURRENCY', CURRENCY_CODE)"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="FIL_valid_unit" TYPE="Filter">
    <TRANSFORMFIELD NAME="TXN_ID"              DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_NUMBER"          DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"            DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="BILL_TO_PARTY_ID"    DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="UNIT_ID"             DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT_OUT" DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(UNIT_ID) AND UNIT_ID &gt; 0"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="LKP_party_master" TYPE="Lookup">
    <TRANSFORMFIELD NAME="IN_PARTY_ID" DATATYPE="number"   PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="PARTY_ID"    DATATYPE="number"   PORTTYPE="LOOKUP"/>
    <TRANSFORMFIELD NAME="PARTY_NAME"  DATATYPE="varchar2" PORTTYPE="LOOKUP/OUTPUT"/>
    <TABLEATTRIBUTE NAME="Lookup table name"  VALUE="FIN.party_master"/>
    <TABLEATTRIBUTE NAME="Lookup condition"   VALUE="PARTY_ID = IN_PARTY_ID"/>
    <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use First Value"/>
  </TRANSFORMATION>

  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="TXN_ID"           TOINSTANCE="SQ_invoice_txn" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="TXN_NUMBER"       TOINSTANCE="SQ_invoice_txn" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="TXN_DATE"         TOINSTANCE="SQ_invoice_txn" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="BILL_TO_PARTY_ID" TOINSTANCE="SQ_invoice_txn" TOFIELD="BILL_TO_PARTY_ID"/>
  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="UNIT_ID"          TOINSTANCE="SQ_invoice_txn" TOFIELD="UNIT_ID"/>
  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="INVOICED_AMOUNT"  TOINSTANCE="SQ_invoice_txn" TOFIELD="INVOICED_AMOUNT"/>
  <CONNECTOR FROMINSTANCE="invoice_txn" FROMFIELD="CURRENCY_CODE"    TOINSTANCE="SQ_invoice_txn" TOFIELD="CURRENCY_CODE"/>

  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="TXN_ID"           TOINSTANCE="EXP_txn_defaults" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="TXN_NUMBER"       TOINSTANCE="EXP_txn_defaults" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="TXN_DATE"         TOINSTANCE="EXP_txn_defaults" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="BILL_TO_PARTY_ID" TOINSTANCE="EXP_txn_defaults" TOFIELD="BILL_TO_PARTY_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="UNIT_ID"          TOINSTANCE="EXP_txn_defaults" TOFIELD="UNIT_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="INVOICED_AMOUNT"  TOINSTANCE="EXP_txn_defaults" TOFIELD="INVOICED_AMOUNT"/>
  <CONNECTOR FROMINSTANCE="SQ_invoice_txn" FROMFIELD="CURRENCY_CODE"    TOINSTANCE="EXP_txn_defaults" TOFIELD="CURRENCY_CODE"/>

  <CONNECTOR FROMINSTANCE="EXP_txn_defaults" FROMFIELD="TXN_ID"              TOINSTANCE="FIL_valid_unit" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="EXP_txn_defaults" FROMFIELD="TXN_NUMBER"          TOINSTANCE="FIL_valid_unit" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="EXP_txn_defaults" FROMFIELD="TXN_DATE"            TOINSTANCE="FIL_valid_unit" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="EXP_txn_defaults" FROMFIELD="BILL_TO_PARTY_ID"    TOINSTANCE="FIL_valid_unit" TOFIELD="BILL_TO_PARTY_ID"/>
  <CONNECTOR FROMINSTANCE="EXP_txn_defaults" FROMFIELD="UNIT_ID"             TOINSTANCE="FIL_valid_unit" TOFIELD="UNIT_ID"/>
  <CONNECTOR FROMINSTANCE="EXP_txn_defaults" FROMFIELD="INVOICED_AMOUNT_OUT" TOINSTANCE="FIL_valid_unit" TOFIELD="INVOICED_AMOUNT_OUT"/>

  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="BILL_TO_PARTY_ID"    TOINSTANCE="LKP_party_master" TOFIELD="IN_PARTY_ID"/>

  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="TXN_ID"              TOINSTANCE="stg_invoice_txn" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="TXN_NUMBER"          TOINSTANCE="stg_invoice_txn" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="TXN_DATE"            TOINSTANCE="stg_invoice_txn" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="BILL_TO_PARTY_ID"    TOINSTANCE="stg_invoice_txn" TOFIELD="BILL_TO_PARTY_ID"/>
  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="UNIT_ID"             TOINSTANCE="stg_invoice_txn" TOFIELD="UNIT_ID"/>
  <CONNECTOR FROMINSTANCE="FIL_valid_unit"  FROMFIELD="INVOICED_AMOUNT_OUT" TOINSTANCE="stg_invoice_txn" TOFIELD="INVOICED_AMOUNT"/>
  <CONNECTOR FROMINSTANCE="LKP_party_master" FROMFIELD="PARTY_NAME"         TOINSTANCE="stg_invoice_txn" TOFIELD="PARTY_NAME"/>
</MAPPING>

<!-- ============ 2. staging to fact, with surrogate keys and an update strategy ============ -->
<MAPPING NAME="m_load_invoice_fact" DESCRIPTION="Load the invoice fact from staging, resolving dimension keys" ISVALID="YES">
  <INSTANCE NAME="stg_invoice_txn" TYPE="SOURCE" TRANSFORMATION_NAME="stg_invoice_txn" TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="fct_invoice_txn" TYPE="TARGET" TRANSFORMATION_NAME="fct_invoice_txn" TRANSFORMATION_TYPE="Target Definition"/>

  <TRANSFORMATION NAME="SQ_stg_invoice_txn" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="TXN_ID"           DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_NUMBER"       DATATYPE="varchar2" PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"         DATATYPE="date"     PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="BILL_TO_PARTY_ID" DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="UNIT_ID"          DATATYPE="number"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT"  DATATYPE="number"   PORTTYPE="OUTPUT"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="LKP_dim_party" TYPE="Lookup">
    <TRANSFORMFIELD NAME="IN_PARTY_ID" DATATYPE="number" PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="PARTY_ID"    DATATYPE="number" PORTTYPE="LOOKUP"/>
    <TRANSFORMFIELD NAME="PARTY_SK"    DATATYPE="number" PORTTYPE="LOOKUP/OUTPUT"/>
    <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DW.dim_party"/>
    <TABLEATTRIBUTE NAME="Lookup condition"  VALUE="PARTY_ID = IN_PARTY_ID"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="LKP_dim_unit" TYPE="Lookup">
    <TRANSFORMFIELD NAME="IN_UNIT_ID" DATATYPE="number" PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="UNIT_ID"    DATATYPE="number" PORTTYPE="LOOKUP"/>
    <TRANSFORMFIELD NAME="UNIT_SK"    DATATYPE="number" PORTTYPE="LOOKUP/OUTPUT"/>
    <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DW.dim_unit"/>
    <TABLEATTRIBUTE NAME="Lookup condition"  VALUE="UNIT_ID = IN_UNIT_ID"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="EXP_scd_logic" TYPE="Expression">
    <TRANSFORMFIELD NAME="TXN_ID"          DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_NUMBER"      DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"        DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="PARTY_SK"        DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="UNIT_SK"         DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT" DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="CHANGE_FLAG"     DATATYPE="varchar2" PORTTYPE="OUTPUT" EXPRESSION="IIF(ISNULL(PARTY_SK), 'N', 'U')"/>
    <TRANSFORMFIELD NAME="INSERT_DT"       DATATYPE="date"     PORTTYPE="OUTPUT" EXPRESSION="SYSDATE"/>
    <TRANSFORMFIELD NAME="UPDATE_DT"       DATATYPE="date"     PORTTYPE="OUTPUT" EXPRESSION="SYSDATE"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="UPD_invoice_fact" TYPE="Update Strategy">
    <TRANSFORMFIELD NAME="TXN_ID"          DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_NUMBER"      DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"        DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="PARTY_SK"        DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="UNIT_SK"         DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT" DATATYPE="number"   PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="CHANGE_FLAG"     DATATYPE="varchar2" PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="INSERT_DT"       DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TRANSFORMFIELD NAME="UPDATE_DT"       DATATYPE="date"     PORTTYPE="INPUT/OUTPUT"/>
    <TABLEATTRIBUTE NAME="Update Strategy Expression" VALUE="IIF(CHANGE_FLAG = 'N', DD_INSERT, DD_UPDATE)"/>
  </TRANSFORMATION>

  <CONNECTOR FROMINSTANCE="stg_invoice_txn" FROMFIELD="TXN_ID"           TOINSTANCE="SQ_stg_invoice_txn" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="stg_invoice_txn" FROMFIELD="TXN_NUMBER"       TOINSTANCE="SQ_stg_invoice_txn" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="stg_invoice_txn" FROMFIELD="TXN_DATE"         TOINSTANCE="SQ_stg_invoice_txn" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="stg_invoice_txn" FROMFIELD="BILL_TO_PARTY_ID" TOINSTANCE="SQ_stg_invoice_txn" TOFIELD="BILL_TO_PARTY_ID"/>
  <CONNECTOR FROMINSTANCE="stg_invoice_txn" FROMFIELD="UNIT_ID"          TOINSTANCE="SQ_stg_invoice_txn" TOFIELD="UNIT_ID"/>
  <CONNECTOR FROMINSTANCE="stg_invoice_txn" FROMFIELD="INVOICED_AMOUNT"  TOINSTANCE="SQ_stg_invoice_txn" TOFIELD="INVOICED_AMOUNT"/>

  <CONNECTOR FROMINSTANCE="SQ_stg_invoice_txn" FROMFIELD="BILL_TO_PARTY_ID" TOINSTANCE="LKP_dim_party" TOFIELD="IN_PARTY_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_stg_invoice_txn" FROMFIELD="UNIT_ID"          TOINSTANCE="LKP_dim_unit"  TOFIELD="IN_UNIT_ID"/>

  <CONNECTOR FROMINSTANCE="SQ_stg_invoice_txn" FROMFIELD="TXN_ID"          TOINSTANCE="EXP_scd_logic" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_stg_invoice_txn" FROMFIELD="TXN_NUMBER"      TOINSTANCE="EXP_scd_logic" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="SQ_stg_invoice_txn" FROMFIELD="TXN_DATE"        TOINSTANCE="EXP_scd_logic" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="SQ_stg_invoice_txn" FROMFIELD="INVOICED_AMOUNT" TOINSTANCE="EXP_scd_logic" TOFIELD="INVOICED_AMOUNT"/>
  <CONNECTOR FROMINSTANCE="LKP_dim_party" FROMFIELD="PARTY_SK" TOINSTANCE="EXP_scd_logic" TOFIELD="PARTY_SK"/>
  <CONNECTOR FROMINSTANCE="LKP_dim_unit"  FROMFIELD="UNIT_SK"  TOINSTANCE="EXP_scd_logic" TOFIELD="UNIT_SK"/>

  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="TXN_ID"          TOINSTANCE="UPD_invoice_fact" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="TXN_NUMBER"      TOINSTANCE="UPD_invoice_fact" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="TXN_DATE"        TOINSTANCE="UPD_invoice_fact" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="PARTY_SK"        TOINSTANCE="UPD_invoice_fact" TOFIELD="PARTY_SK"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="UNIT_SK"         TOINSTANCE="UPD_invoice_fact" TOFIELD="UNIT_SK"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="INVOICED_AMOUNT" TOINSTANCE="UPD_invoice_fact" TOFIELD="INVOICED_AMOUNT"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="CHANGE_FLAG"     TOINSTANCE="UPD_invoice_fact" TOFIELD="CHANGE_FLAG"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="INSERT_DT"       TOINSTANCE="UPD_invoice_fact" TOFIELD="INSERT_DT"/>
  <CONNECTOR FROMINSTANCE="EXP_scd_logic" FROMFIELD="UPDATE_DT"       TOINSTANCE="UPD_invoice_fact" TOFIELD="UPDATE_DT"/>

  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="TXN_ID"          TOINSTANCE="fct_invoice_txn" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="TXN_NUMBER"      TOINSTANCE="fct_invoice_txn" TOFIELD="TXN_NUMBER"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="TXN_DATE"        TOINSTANCE="fct_invoice_txn" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="PARTY_SK"        TOINSTANCE="fct_invoice_txn" TOFIELD="PARTY_SK"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="UNIT_SK"         TOINSTANCE="fct_invoice_txn" TOFIELD="UNIT_SK"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="INVOICED_AMOUNT" TOINSTANCE="fct_invoice_txn" TOFIELD="INVOICED_AMOUNT"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="CHANGE_FLAG"     TOINSTANCE="fct_invoice_txn" TOFIELD="CHANGE_FLAG"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="INSERT_DT"       TOINSTANCE="fct_invoice_txn" TOFIELD="INSERT_DT"/>
  <CONNECTOR FROMINSTANCE="UPD_invoice_fact" FROMFIELD="UPDATE_DT"       TOINSTANCE="fct_invoice_txn" TOFIELD="UPDATE_DT"/>
</MAPPING>

<!-- ============ 3. fact to monthly aggregate ============ -->
<MAPPING NAME="m_rollup_revenue" DESCRIPTION="Monthly revenue rollup by party" ISVALID="YES">
  <INSTANCE NAME="fct_invoice_txn"     TYPE="SOURCE" TRANSFORMATION_NAME="fct_invoice_txn"     TRANSFORMATION_TYPE="Source Definition"/>
  <INSTANCE NAME="agg_revenue_monthly" TYPE="TARGET" TRANSFORMATION_NAME="agg_revenue_monthly" TRANSFORMATION_TYPE="Target Definition"/>

  <TRANSFORMATION NAME="SQ_fct_invoice_txn" TYPE="Source Qualifier">
    <TRANSFORMFIELD NAME="TXN_ID"          DATATYPE="number" PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="PARTY_SK"        DATATYPE="number" PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="TXN_DATE"        DATATYPE="date"   PORTTYPE="OUTPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT" DATATYPE="number" PORTTYPE="OUTPUT"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="AGG_revenue_summary" TYPE="Aggregator">
    <TRANSFORMFIELD NAME="PARTY_SK"        DATATYPE="number" PORTTYPE="INPUT/OUTPUT GROUP BY" EXPRESSION="PARTY_SK"/>
    <TRANSFORMFIELD NAME="TXN_DATE"        DATATYPE="date"   PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="TXN_ID"          DATATYPE="number" PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="INVOICED_AMOUNT" DATATYPE="number" PORTTYPE="INPUT"/>
    <TRANSFORMFIELD NAME="PERIOD_KEY"      DATATYPE="number" PORTTYPE="OUTPUT" EXPRESSION="TO_INTEGER(TO_CHAR(TXN_DATE, 'YYYYMM'))"/>
    <TRANSFORMFIELD NAME="TOTAL_REVENUE"   DATATYPE="number" PORTTYPE="OUTPUT" EXPRESSION="SUM(INVOICED_AMOUNT)"/>
    <TRANSFORMFIELD NAME="TXN_COUNT"       DATATYPE="number" PORTTYPE="OUTPUT" EXPRESSION="COUNT(TXN_ID)"/>
    <TABLEATTRIBUTE NAME="Group by" VALUE="PARTY_SK"/>
  </TRANSFORMATION>

  <CONNECTOR FROMINSTANCE="fct_invoice_txn" FROMFIELD="TXN_ID"          TOINSTANCE="SQ_fct_invoice_txn" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="fct_invoice_txn" FROMFIELD="PARTY_SK"        TOINSTANCE="SQ_fct_invoice_txn" TOFIELD="PARTY_SK"/>
  <CONNECTOR FROMINSTANCE="fct_invoice_txn" FROMFIELD="TXN_DATE"        TOINSTANCE="SQ_fct_invoice_txn" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="fct_invoice_txn" FROMFIELD="INVOICED_AMOUNT" TOINSTANCE="SQ_fct_invoice_txn" TOFIELD="INVOICED_AMOUNT"/>

  <CONNECTOR FROMINSTANCE="SQ_fct_invoice_txn" FROMFIELD="TXN_ID"          TOINSTANCE="AGG_revenue_summary" TOFIELD="TXN_ID"/>
  <CONNECTOR FROMINSTANCE="SQ_fct_invoice_txn" FROMFIELD="PARTY_SK"        TOINSTANCE="AGG_revenue_summary" TOFIELD="PARTY_SK"/>
  <CONNECTOR FROMINSTANCE="SQ_fct_invoice_txn" FROMFIELD="TXN_DATE"        TOINSTANCE="AGG_revenue_summary" TOFIELD="TXN_DATE"/>
  <CONNECTOR FROMINSTANCE="SQ_fct_invoice_txn" FROMFIELD="INVOICED_AMOUNT" TOINSTANCE="AGG_revenue_summary" TOFIELD="INVOICED_AMOUNT"/>

  <CONNECTOR FROMINSTANCE="AGG_revenue_summary" FROMFIELD="PARTY_SK"      TOINSTANCE="agg_revenue_monthly" TOFIELD="PARTY_SK"/>
  <CONNECTOR FROMINSTANCE="AGG_revenue_summary" FROMFIELD="PERIOD_KEY"    TOINSTANCE="agg_revenue_monthly" TOFIELD="PERIOD_KEY"/>
  <CONNECTOR FROMINSTANCE="AGG_revenue_summary" FROMFIELD="TOTAL_REVENUE" TOINSTANCE="agg_revenue_monthly" TOFIELD="TOTAL_REVENUE"/>
  <CONNECTOR FROMINSTANCE="AGG_revenue_summary" FROMFIELD="TXN_COUNT"     TOINSTANCE="agg_revenue_monthly" TOFIELD="TXN_COUNT"/>
</MAPPING>

<SESSION NAME="s_m_stage_invoice_txn" MAPPINGNAME="m_stage_invoice_txn" DESCRIPTION="Stage invoice transactions" ISVALID="YES" REUSABLE="NO">
  <CONNECTIONREFERENCE CONNECTIONNAME="OLTPFIN_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Source" INSTANCENAME="invoice_txn" COMPONENTNAME="Source Qualifier Reader"/>
  <CONNECTIONREFERENCE CONNECTIONNAME="STGFIN_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Target" INSTANCENAME="stg_invoice_txn" COMPONENTNAME="Target Writer"/>
  <SESSIONEXTENSION NAME="Target Writer" TRANSFORMATIONTYPE="Target Definition">
    <ATTRIBUTE NAME="Treat source rows as" VALUE="Insert"/>
  </SESSIONEXTENSION>
</SESSION>

<SESSION NAME="s_m_load_invoice_fact" MAPPINGNAME="m_load_invoice_fact" DESCRIPTION="Load the invoice fact" ISVALID="YES" REUSABLE="NO">
  <CONNECTIONREFERENCE CONNECTIONNAME="STGFIN_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Source" INSTANCENAME="stg_invoice_txn" COMPONENTNAME="Source Qualifier Reader"/>
  <CONNECTIONREFERENCE CONNECTIONNAME="DWFIN_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Target" INSTANCENAME="fct_invoice_txn" COMPONENTNAME="Target Writer"/>
  <SESSIONEXTENSION NAME="Target Writer" TRANSFORMATIONTYPE="Target Definition">
    <ATTRIBUTE NAME="Treat source rows as" VALUE="Data Driven"/>
  </SESSIONEXTENSION>
</SESSION>

<SESSION NAME="s_m_rollup_revenue" MAPPINGNAME="m_rollup_revenue" DESCRIPTION="Monthly revenue rollup" ISVALID="YES" REUSABLE="NO">
  <CONNECTIONREFERENCE CONNECTIONNAME="DWFIN_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Source" INSTANCENAME="fct_invoice_txn" COMPONENTNAME="Source Qualifier Reader"/>
  <CONNECTIONREFERENCE CONNECTIONNAME="DWFIN_CONN" CONNECTIONTYPE="Oracle" VARIABLE="$Target" INSTANCENAME="agg_revenue_monthly" COMPONENTNAME="Target Writer"/>
</SESSION>

<WORKFLOW NAME="wf_finance_analytics" SERVERNAME="PROD_SVC" ISENABLED="YES" DESCRIPTION="Nightly finance warehouse load">
  <TASKINSTANCE NAME="Start"                 TASKNAME="Start"                 TASKTYPE="Start"/>
  <TASKINSTANCE NAME="s_m_stage_invoice_txn" TASKNAME="s_m_stage_invoice_txn" TASKTYPE="Session"/>
  <TASKINSTANCE NAME="s_m_load_invoice_fact" TASKNAME="s_m_load_invoice_fact" TASKTYPE="Session"/>
  <TASKINSTANCE NAME="s_m_rollup_revenue"    TASKNAME="s_m_rollup_revenue"    TASKTYPE="Session"/>
  <WORKFLOWLINK FROMTASK="Start"                 TOTASK="s_m_stage_invoice_txn" CONDITION=""/>
  <WORKFLOWLINK FROMTASK="s_m_stage_invoice_txn" TOTASK="s_m_load_invoice_fact" CONDITION="$s_m_stage_invoice_txn.Status = SUCCEEDED"/>
  <WORKFLOWLINK FROMTASK="s_m_load_invoice_fact" TOTASK="s_m_rollup_revenue"    CONDITION="$s_m_load_invoice_fact.Status = SUCCEEDED"/>
</WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
