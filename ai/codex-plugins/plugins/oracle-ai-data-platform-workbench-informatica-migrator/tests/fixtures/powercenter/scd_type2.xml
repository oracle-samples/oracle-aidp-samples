<?xml version="1.0" encoding="UTF-8"?>
<MAPPING NAME="m_scd_type2" DESCRIPTION="SCD Type 2: maintain full history with date ranges">
    <SOURCE NAME="EMPLOYEES_STAGE" DBDNAME="HR_DB" OWNERNAME="STAGING" DATABASETYPE="Oracle" DESCRIPTION="Staged employee records">
        <SOURCEFIELD NAME="EMP_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <SOURCEFIELD NAME="NAME" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="DEPT" DATATYPE="string" PRECISION="60" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <SOURCEFIELD NAME="SALARY" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </SOURCE>
    <TARGET NAME="TGT_EMPLOYEES_HIST" DATABASETYPE="Oracle" DBDNAME="DW_DB" OWNERNAME="ANALYTICS" DESCRIPTION="Employee history dimension, SCD Type 2">
        <TARGETFIELD NAME="EMP_ID" DATATYPE="integer" PRECISION="10" SCALE="0" KEYTYPE="PRIMARY KEY" NULLABLE="NOTNULL"/>
        <TARGETFIELD NAME="NAME" DATATYPE="string" PRECISION="120" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="DEPT" DATATYPE="string" PRECISION="60" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="SALARY" DATATYPE="decimal" PRECISION="10" SCALE="2" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="EFF_START" DATATYPE="date" PRECISION="19" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
        <TARGETFIELD NAME="IS_CURRENT" DATATYPE="integer" PRECISION="1" SCALE="0" KEYTYPE="NOT A KEY" NULLABLE="NULL"/>
    </TARGET>
    <INSTANCE NAME="EMPLOYEES_STAGE" TYPE="SOURCE" TRANSFORMATION_NAME="EMPLOYEES_STAGE" TRANSFORMATION_TYPE="Source Definition"/>
    <INSTANCE NAME="TGT_EMPLOYEES_HIST" TYPE="TARGET" TRANSFORMATION_NAME="TGT_EMPLOYEES_HIST" TRANSFORMATION_TYPE="Target Definition"/>
    <TRANSFORMATION NAME="SQ_EMPLOYEES" TYPE="Source Qualifier">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT EMP_ID, NAME, DEPT, SALARY FROM EMPLOYEES_STAGE"/>
        <TRANSFORMFIELD NAME="EMP_ID" DATATYPE="integer" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="NAME" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="DEPT" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="SALARY" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="LKP_CURRENT" TYPE="Lookup">
        <TABLEATTRIBUTE NAME="condition" VALUE="LKP_CURRENT.EMP_ID = SQ_EMPLOYEES.EMP_ID AND LKP_CURRENT.IS_CURRENT = 1"/>
        <TRANSFORMFIELD NAME="EMP_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="LKP_DEPT" DATATYPE="string" PORTTYPE="OUTPUT"/>
        <TRANSFORMFIELD NAME="LKP_SALARY" DATATYPE="decimal" PORTTYPE="OUTPUT"/>
    </TRANSFORMATION>
    <TRANSFORMATION NAME="EXP_DETECT_CHANGE" TYPE="Expression">
        <TRANSFORMFIELD NAME="EMP_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="DEPT" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="SALARY" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="LKP_DEPT" DATATYPE="string" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="LKP_SALARY" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="IS_CHANGED" DATATYPE="integer" PORTTYPE="OUTPUT" EXPRESSION="IIF(DEPT != LKP_DEPT OR SALARY != LKP_SALARY, 1, 0)"/>
        <TRANSFORMFIELD NAME="EFF_START" DATATYPE="date" PORTTYPE="OUTPUT" EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>
    <CONNECTOR FROMINSTANCE="EMPLOYEES_STAGE" FROMFIELD="EMP_ID" TOINSTANCE="SQ_EMPLOYEES" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMINSTANCE="EMPLOYEES_STAGE" FROMFIELD="NAME" TOINSTANCE="SQ_EMPLOYEES" TOFIELD="NAME"/>
    <CONNECTOR FROMINSTANCE="EMPLOYEES_STAGE" FROMFIELD="DEPT" TOINSTANCE="SQ_EMPLOYEES" TOFIELD="DEPT"/>
    <CONNECTOR FROMINSTANCE="EMPLOYEES_STAGE" FROMFIELD="SALARY" TOINSTANCE="SQ_EMPLOYEES" TOFIELD="SALARY"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="EMP_ID" TOINSTANCE="LKP_CURRENT" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="EMP_ID" TOINSTANCE="EXP_DETECT_CHANGE" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="DEPT" TOINSTANCE="EXP_DETECT_CHANGE" TOFIELD="DEPT"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="SALARY" TOINSTANCE="EXP_DETECT_CHANGE" TOFIELD="SALARY"/>
    <CONNECTOR FROMINSTANCE="LKP_CURRENT" FROMFIELD="LKP_DEPT" TOINSTANCE="EXP_DETECT_CHANGE" TOFIELD="LKP_DEPT"/>
    <CONNECTOR FROMINSTANCE="LKP_CURRENT" FROMFIELD="LKP_SALARY" TOINSTANCE="EXP_DETECT_CHANGE" TOFIELD="LKP_SALARY"/>
    <CONNECTOR FROMINSTANCE="EXP_DETECT_CHANGE" FROMFIELD="EMP_ID" TOINSTANCE="TGT_EMPLOYEES_HIST" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMINSTANCE="EXP_DETECT_CHANGE" FROMFIELD="EFF_START" TOINSTANCE="TGT_EMPLOYEES_HIST" TOFIELD="EFF_START"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="NAME" TOINSTANCE="TGT_EMPLOYEES_HIST" TOFIELD="NAME"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="DEPT" TOINSTANCE="TGT_EMPLOYEES_HIST" TOFIELD="DEPT"/>
    <CONNECTOR FROMINSTANCE="SQ_EMPLOYEES" FROMFIELD="SALARY" TOINSTANCE="TGT_EMPLOYEES_HIST" TOFIELD="SALARY"/>
    <CONNECTOR FROMINSTANCE="EXP_DETECT_CHANGE" FROMFIELD="IS_CHANGED" TOINSTANCE="TGT_EMPLOYEES_HIST" TOFIELD="IS_CURRENT"/>
</MAPPING>
