# Copy to .env (gitignored) and fill in your Oracle AI Data Platform instance.
# Only the optional laptop scripts (scripts/) read this file; the scheduled job takes its
# settings from the Workflow task's environment variables (see the table in README.md).
# Auth itself comes from the OCI config profile named below (API key); no secrets go in this file.
NS_REGION=us-ashburn-1
NS_DATA_LAKE_ID=ocid1.aidataplatform.oc1.<region>.<your-data-lake-ocid>
NS_WORKSPACE_ID=<workspace key, uuid>
NS_CLUSTER_ID=<cluster key, uuid>
NS_OCI_PROFILE=DEFAULT
NS_CATALOG=default
NS_OPS_SCHEMA=nightshift_ops
NS_NOTEBOOK=Shared/nightshift/_nightshift_runner.ipynb

# Optional, shared with the job (defaults shown):
# NS_OPS=default.nightshift_ops
# NS_DRAFT_MODEL=xai.grok-4.7
# NS_DRAFT_MODEL_LOW=xai.grok-4.20-non-reasoning
# NS_SHAPE_ALLOWLIST=amd.generic
